</style>

<script is:inline>
  (function() {
    var images = [
      "01_full_dual_system_rgb.webp",
      "02_test_bench_dark_moody.webp",
      "02_test_bench_dark_moody.png",
      "03_itx_coolermaster_pink_rgb.webp",
      "04_rgb_interior_aio27_evga_rainbow.webp",
      "05_pikvm_oled_purple_blue.webp",
      "06_evga_3070ti_natural_light.webp",
      "07_rgb_interior_wide_angle.webp",
      "08_warm_gold_green_rgb.webp",
      "09_side_angle_ribbons_cm_blue.webp",
      "10_low_angle_evga_bottom_fans.webp",
      "11_i7_14700kf_socket.webp",
      "12_topdown_dual_system.webp",
      "13_both_gpus_everything_shot.webp",
      "14_phone_cluster_raw_chaos.webp",
      "15_rgb_teal_cyan_variant.webp",
      "16_itx_coolermaster_detail.webp",
      "17_green_wash_full_front.webp",
      "18_prusa_mini_midprint.webp",
      "19_rog_z790_hero_pikvm.webp",
      "20_aorus_b760i_rear_io.webp",
      "21_nzxt_aio_rainbow_interior.webp",
      "22_pikvm_tablet_green_rgb.webp",
      "21_nzxt_aio_rainbow_interior.jpg",
      "22_pikvm_tablet_green_rgb.jpg",
      "23_rgb_teal_ribbons_alt.webp",
      "24_working_shot_cm_orange.webp",
      "25_back_panel_fans_hub_psu.webp",
      "26_case_rear_exterior.webp",
      "27_prusa_printing_54pct.webp",
      "28_pikvm_rgb_backlit.webp",
      "29_crown_vic_mobile_office.webp",
      "30_b760i_ram_pico_board.webp",
      "31_derogue_pico_closeup.webp",
      "29_crown_vic_mobile_office.jpg",
      "30_b760i_ram_pico_board.jpg",
      "31_derogue_pico_closeup.jpg",
      "32_xmax_slicer_cluster_parts.webp",
      "33_back_panel_alt_lianli.webp",
      "34_b760i_cm_copper_base.webp",
      "35_battlestation_multimonitor.webp"
    ];

    var basePath = "/assets/pc/";
    var currentIndex = 0;

    // ── Derive readable alt text from filename ──
    function altFromFilename(filename) {
      return filename
        .replace(/\.\w+$/, "")        // strip extension
        .replace(/^\d+_/, "")          // strip leading number prefix
        .replace(/_/g, " ")            // underscores to spaces
        .replace(/\b\w/g, function(c) { return c.toUpperCase(); });
    }

    // ── Hero image opens lightbox at index 0 ──
    var heroImg = document.getElementById("rig-hero-img");
    if (heroImg) {
      heroImg.addEventListener("click", function() {
        openLightbox(0);
      });
    }

    // ── Build Gallery Grid (skip first image, shown as hero) ──
    var grid = document.getElementById("rig-gallery");
    if (grid) {
      images.forEach(function(img, idx) {
        if (idx === 0) return; // already shown as hero
        var div = document.createElement("div");
        div.className = "rig-thumb";
        div.setAttribute("data-index", idx);
        // span last image across 2 columns
        if (idx === images.length - 1) {
          div.classList.add("col-span-2");
        }

        var imgEl = document.createElement("img");
        imgEl.src = basePath + img;
        imgEl.alt = altFromFilename(img);
        imgEl.loading = "lazy";

        div.appendChild(imgEl);
        grid.appendChild(div);

        div.addEventListener("click", function() {
          openLightbox(idx);
        });
      });
    }

    // ── Lightbox ──
    var lightbox = document.getElementById("rig-lightbox");
    var lbImg = document.getElementById("rig-lb-img");
    var lbCounter = document.getElementById("rig-lb-counter");
    var lbClose = document.getElementById("rig-lb-close");
    var lbPrev = document.getElementById("rig-lb-prev");
    var lbNext = document.getElementById("rig-lb-next");

    function openLightbox(idx) {
      currentIndex = idx;
      updateLightboxImage();
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "";
    }

    function updateLightboxImage() {
      lbImg.src = basePath + images[currentIndex];
      lbImg.alt = altFromFilename(images[currentIndex]);
      lbCounter.textContent = (currentIndex + 1) + " / " + images.length;
    }

    function prevImage() {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      updateLightboxImage();
    }

    function nextImage() {
      currentIndex = (currentIndex + 1) % images.length;
      updateLightboxImage();
    }

    if (lbClose) lbClose.addEventListener("click", closeLightbox);
    if (lbPrev) lbPrev.addEventListener("click", prevImage);
    if (lbNext) lbNext.addEventListener("click", nextImage);

    if (lightbox) {
      lightbox.addEventListener("click", function(e) {
        if (e.target === lightbox) closeLightbox();
      });
    }

    document.addEventListener("keydown", function(e) {
      if (!lightbox || lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") prevImage();
      if (e.key === "ArrowRight") nextImage();
    });

    // Touch / Swipe
    var touchStartX = 0;
    if (lightbox) {
      lightbox.addEventListener("touchstart", function(e) {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      lightbox.addEventListener("touchend", function(e) {
        var diff = touchStartX - e.changedTouches[0].screenX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) nextImage(); else prevImage();
        }
      }, { passive: true });
    }
  })();
</script>
