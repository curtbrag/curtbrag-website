// ── Swarm tab ────────────────────────────────────────────────────────────────
const SWARM_API = '/.netlify/functions/swarm-core';
let swarmInterval = null;

function onSwarmTabClick() {
  fetchSwarmStatus();
  if (!swarmInterval) swarmInterval = setInterval(fetchSwarmStatus, 5000);
}

async function fetchSwarmStatus() {
  try {
    const r = await fetch(`${SWARM_API}?action=queue-status`);
    if (!r.ok) return;
    const d = await r.json();
    renderSwarmStatus(d);
  } catch {}
}

function renderSwarmStatus(d) {
  document.getElementById('swarm-queued').textContent = d.queued ?? 0;
  document.getElementById('swarm-nodes-online').textContent = d.nodes_online ?? 0;
  document.getElementById('swarm-total').textContent = d.total_completed ?? 0;

  const nodes = d.nodes || [];
  document.getElementById('swarm-nodes').innerHTML = nodes.length
    ? nodes.map(n => {
        const c = n.online ? 'var(--color-green)' : 'var(--color-red)';
        return `<div style="background:var(--color-bg);border-radius:6px;padding:10px;border-left:3px solid ${c}">
          <div style="font-weight:600;font-size:12px;margin-bottom:2px">
            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${c};margin-right:6px"></span>${n.id}
          </div>
          <div style="font-size:11px;color:var(--color-muted)">Last seen: ${timeAgo(n.last_seen)}</div>
          ${n.last_job ? `<div style="font-size:10px;color:var(--color-muted)">Job: ${n.last_job.slice(0,12)}… exit:${n.last_exit ?? '?'}</div>` : ''}
        </div>`;
      }).join('')
    : '<span style="color:var(--color-muted)">No nodes have checked in yet</span>';

  const jobs = d.jobs || [];
  document.getElementById('swarm-queue-list').innerHTML = jobs.length
    ? jobs.map(j => `<div style="padding:8px;background:var(--color-bg);border-radius:4px;margin:4px 0;border-left:3px solid var(--color-yellow);font-family:monospace;font-size:11px">
        <div style="display:flex;justify-content:space-between">
          <strong>${j.type}</strong>
          <span style="color:var(--color-muted)">${timeAgo(j.queued_at)}</span>
        </div>
        <div style="color:var(--color-muted)">${j.cmd || j.command || ''}</div>
        ${j.device_id ? `<div style="font-size:10px;color:var(--color-muted)">→ ${j.device_id}</div>` : ''}
      </div>`).join('')
    : 'Empty';

  const results = d.results || [];
  document.getElementById('swarm-results').innerHTML = results.length
    ? results.map(r => `<div style="padding:8px;background:var(--color-bg);border-radius:4px;margin:4px 0;border-left:3px solid ${r.exit_code === 0 ? 'var(--color-green)' : 'var(--color-red)'}">
        <div style="display:flex;justify-content:space-between;margin-bottom:4px">
          <span><strong>${r.type || 'shell'}</strong> · <code style="font-size:10px">${r.device_id}</code> · exit:${r.exit_code ?? '?'}</span>
          <span style="color:var(--color-muted);font-size:10px">${timeAgo(r.completed_at)}</span>
        </div>
        ${r.cmd ? `<div style="font-size:10px;color:var(--color-muted);font-family:monospace;margin-bottom:4px">$ ${r.cmd}</div>` : ''}
        ${r.stdout ? `<pre style="margin:0;font-size:10px;color:var(--color-muted);white-space:pre-wrap;max-height:60px;overflow-y:auto">${r.stdout.slice(0,300)}</pre>` : ''}
      </div>`).join('')
    : 'No results yet';
}

async function submitSwarmJob() {
  const type = document.getElementById('swarm-job-type').value;
  const cmd = document.getElementById('swarm-job-cmd').value.trim();
  const device_id = document.getElementById('swarm-job-device').value.trim();
  if (!cmd) { toast('Command / message is required', 'error'); return; }
  const job = {
    id: `web-${Date.now()}-${Math.random().toString(36).slice(2,7)}`,
    type,
    cmd,
    command: cmd,
  };
  if (device_id) job.device_id = device_id;
  try {
    const r = await fetch(`${SWARM_API}?action=enqueue`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ job }),
    });
    const d = await r.json();
    if (d.ok) {
      toast(`Job enqueued (queue: ${d.queue_count})`);
      document.getElementById('swarm-job-cmd').value = '';
      document.getElementById('swarm-job-device').value = '';
      fetchSwarmStatus();
    } else {
      toast(`Enqueue failed: ${d.error}`, 'error');
    }
  } catch (e) { toast(`Error: ${e.message}`, 'error'); }
}

async function flushSwarmQueue() {
  if (!confirm('Flush swarm queue?')) return;
  try {
    const r = await fetch(`${SWARM_API}?action=flush-queue`, { method: 'POST' });
    const d = await r.json();
    if (d.ok) { toast('Swarm queue flushed'); fetchSwarmStatus(); }
  } catch (e) { toast(`Error: ${e.message}`, 'error'); }
}

async function clearSwarmResults() {
  if (!confirm('Clear all swarm results?')) return;
  try {
    const r = await fetch(`${SWARM_API}?action=clear-results`, { method: 'POST' });
    const d = await r.json();
    if (d.ok) { toast('Results cleared'); fetchSwarmStatus(); }
  } catch (e) { toast(`Error: ${e.message}`, 'error'); }
}
