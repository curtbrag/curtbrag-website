---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Cluster Control Panel - Curtis Bragdon" description="Authenticated control panel for managing the K3s phone cluster.">

  <!-- ═══════════════════════════════════ LOGIN GATE ═══════════════════════════════════ -->
  <section id="loginGate" class="py-20">
    <div class="max-w-md mx-auto px-4">
      <div class="bg-panel border border-border rounded-xl p-8 text-center">
        <div class="text-4xl mb-4">
          <i class="fa-solid fa-lock text-brand"></i>
        </div>
        <h1 class="text-2xl font-bold mb-2">Cluster Control</h1>
        <p class="text-text-secondary text-sm mb-6">Enter your password to access the control panel.</p>
        <form id="loginForm" class="flex flex-col gap-3">
          <input
            type="password"
            id="loginPassword"
            placeholder="Password"
            autocomplete="current-password"
            class="w-full bg-bg border border-border rounded-lg px-4 py-3 text-sm text-text placeholder-muted focus:outline-none focus:border-brand transition"
          />
          <button type="submit" class="w-full bg-brand hover:bg-brand/90 text-white font-semibold rounded-lg px-4 py-3 text-sm transition">
            <i class="fa-solid fa-right-to-bracket mr-1"></i> Unlock
          </button>
          <div id="loginError" class="text-red text-xs hidden">Invalid password. Try again.</div>
        </form>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════ CONTROL PANEL ═══════════════════════════════════ -->
  <div id="controlPanel" class="hidden">

    <!-- Header -->
    <section class="py-6 md:py-8">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
          <div class="flex items-center gap-3">
            <a href="/cluster" class="text-muted hover:text-text transition text-sm">
              <i class="fa-solid fa-arrow-left"></i> Dashboard
            </a>
            <h1 class="text-xl md:text-2xl font-bold">
              <i class="fa-solid fa-sliders text-brand mr-1"></i> Control Panel
            </h1>
          </div>
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-2 text-xs" id="pollerStatus">
              <span class="w-2 h-2 rounded-full bg-muted" id="pollerDot"></span>
              <span class="text-muted" id="pollerText">Checking poller...</span>
            </span>
            <button id="logoutBtn" class="inline-flex items-center gap-1 bg-panel border border-border rounded-lg px-3 py-1.5 text-xs hover:border-red text-muted hover:text-red transition">
              <i class="fa-solid fa-right-from-bracket"></i> Logout
            </button>
          </div>
        </div>

        <!-- Toast -->
        <div id="toast" class="hidden fixed top-4 right-4 z-50 bg-panel border border-border rounded-xl px-4 py-3 shadow-xl text-sm max-w-sm">
          <span id="toastMsg"></span>
        </div>

        <!-- ═══════════════════ TARGET SELECTOR ═══════════════════ -->
        <div class="bg-panel border border-border rounded-xl p-4 mb-6">
          <label class="text-xs font-semibold text-muted uppercase tracking-wide block mb-2">Target</label>
          <div class="flex flex-wrap gap-2">
            <select id="targetSelect" class="bg-bg border border-border rounded-lg px-3 py-2 text-sm text-text focus:outline-none focus:border-brand transition flex-1 min-w-[180px]">
              <optgroup label="Groups">
                <option value="all">All Nodes</option>
                <option value="phones">All Phones</option>
                <option value="pcs">All PCs</option>
              </optgroup>
              <optgroup label="Phone Nodes">
                <option value="node1">node1 (192.168.1.206) - Control Plane</option>
                <option value="node2">node2 (192.168.1.207)</option>
                <option value="node3">node3 (192.168.1.208)</option>
                <option value="node4">node4 (192.168.1.209)</option>
                <option value="node5">node5 (192.168.1.210)</option>
                <option value="node6">node6 (192.168.1.211)</option>
                <option value="node7">node7 (192.168.1.212)</option>
                <option value="node8">node8 (192.168.1.213)</option>
                <option value="node9">node9 (192.168.1.214)</option>
                <option value="node10">node10 (192.168.1.215)</option>
              </optgroup>
              <optgroup label="PC Nodes">
                <option value="nexus-prime">NEXUS-PRIME (192.168.1.179)</option>
                <option value="neo">AORUS-NODE (192.168.1.251)</option>
                <option value="vikixii">COFFEE-TABLE (192.168.1.228)</option>
              </optgroup>
              <optgroup label="Other">
                <option value="steamdeck">Steam Deck</option>
                <option value="pikvm-main">PiKVM Main</option>
                <option value="pikvm-2">PiKVM 2</option>
              </optgroup>
            </select>
          </div>
        </div>

        <!-- ═══════════════════ QUICK ACTIONS ═══════════════════ -->
        <div class="bg-panel border border-border rounded-xl p-4 mb-6">
          <h2 class="text-xs font-semibold text-muted uppercase tracking-wide mb-3">
            <i class="fa-solid fa-bolt text-yellow mr-1"></i> Quick Actions
          </h2>
          <div class="flex flex-wrap gap-2">
            <button class="cmd-btn" data-cmd="wake">
              <i class="fa-solid fa-sun text-yellow"></i> Wake
            </button>
            <button class="cmd-btn" data-cmd="sleep">
              <i class="fa-solid fa-moon text-blue"></i> Sleep
            </button>
            <button class="cmd-btn" data-cmd="start">
              <i class="fa-solid fa-play text-green"></i> Start
            </button>
            <button class="cmd-btn" data-cmd="stop">
              <i class="fa-solid fa-stop text-red"></i> Stop
            </button>
            <button class="cmd-btn" data-cmd="restart">
              <i class="fa-solid fa-arrows-rotate text-blue"></i> Restart
            </button>
            <button class="cmd-btn" data-cmd="reboot">
              <i class="fa-solid fa-power-off text-red"></i> Reboot
            </button>
            <button class="cmd-btn" data-cmd="update">
              <i class="fa-solid fa-download text-green"></i> Update
            </button>
          </div>
        </div>

        <!-- ═══════════════════ MINING CONTROLS ═══════════════════ -->
        <div class="bg-panel border border-border rounded-xl p-4 mb-6">
          <h2 class="text-xs font-semibold text-muted uppercase tracking-wide mb-3">
            <i class="fa-solid fa-coins text-yellow mr-1"></i> Mining
          </h2>
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <button class="cmd-btn" data-cmd="mining-start">
              <i class="fa-solid fa-play text-green"></i> Start Mining
            </button>
            <button class="cmd-btn" data-cmd="mining-stop">
              <i class="fa-solid fa-stop text-red"></i> Stop Mining
            </button>
          </div>
          <div class="flex items-center gap-3">
            <label class="text-sm text-muted whitespace-nowrap">Mining Level:</label>
            <input type="range" id="miningLevel" min="0" max="4" value="2" class="flex-1 accent-brand" />
            <span class="font-mono text-sm font-bold w-6 text-center" id="miningLevelVal">2</span>
            <button id="miningLevelBtn" class="cmd-btn text-xs">
              <i class="fa-solid fa-check"></i> Set
            </button>
          </div>
          <div class="text-muted text-xs mt-2">0 = off, 1 = low, 2 = normal, 3 = high, 4 = max</div>
        </div>

        <!-- ═══════════════════ DISPLAY MODE ═══════════════════ -->
        <div class="bg-panel border border-border rounded-xl p-4 mb-6">
          <h2 class="text-xs font-semibold text-muted uppercase tracking-wide mb-3">
            <i class="fa-solid fa-display text-blue mr-1"></i> Display Mode
          </h2>
          <div class="flex flex-wrap gap-2">
            <button class="cmd-btn display-btn" data-mode="matrix">
              <i class="fa-solid fa-code text-green"></i> Matrix
            </button>
            <button class="cmd-btn display-btn" data-mode="stats">
              <i class="fa-solid fa-chart-bar text-blue"></i> Stats
            </button>
            <button class="cmd-btn display-btn" data-mode="bonsai">
              <i class="fa-solid fa-tree text-green"></i> Bonsai
            </button>
            <button class="cmd-btn display-btn" data-mode="cycle">
              <i class="fa-solid fa-rotate text-yellow"></i> Cycle
            </button>
            <button class="cmd-btn display-btn" data-mode="off">
              <i class="fa-solid fa-power-off text-red"></i> Off
            </button>
          </div>
        </div>

        <!-- ═══════════════════ BRIGHTNESS ═══════════════════ -->
        <div class="bg-panel border border-border rounded-xl p-4 mb-6">
          <h2 class="text-xs font-semibold text-muted uppercase tracking-wide mb-3">
            <i class="fa-solid fa-sun text-yellow mr-1"></i> Brightness
          </h2>
          <div class="flex items-center gap-3">
            <i class="fa-solid fa-moon text-muted text-xs"></i>
            <input type="range" id="brightnessSlider" min="0" max="255" value="128" class="flex-1 accent-brand" />
            <i class="fa-solid fa-sun text-yellow text-xs"></i>
            <span class="font-mono text-sm font-bold w-8 text-center" id="brightnessVal">128</span>
            <button id="brightnessBtn" class="cmd-btn text-xs">
              <i class="fa-solid fa-check"></i> Set
            </button>
          </div>
        </div>

        <!-- ═══════════════════ SSH TERMINAL ═══════════════════ -->
        <div class="bg-panel border border-border rounded-xl p-4 mb-6">
          <h2 class="text-xs font-semibold text-muted uppercase tracking-wide mb-3">
            <i class="fa-solid fa-terminal text-green mr-1"></i> SSH Command
          </h2>
          <div class="flex gap-2 mb-3">
            <input
              type="text"
              id="sshInput"
              placeholder="e.g. uptime, free -h, cat /proc/cpuinfo"
              class="flex-1 bg-bg border border-border rounded-lg px-3 py-2 text-sm font-mono text-text placeholder-muted focus:outline-none focus:border-brand transition"
            />
            <button id="sshSendBtn" class="cmd-btn">
              <i class="fa-solid fa-paper-plane"></i> Run
            </button>
          </div>
          <div id="sshOutput" class="bg-bg border border-border rounded-lg p-3 font-mono text-xs text-muted min-h-[60px] max-h-[300px] overflow-auto whitespace-pre-wrap hidden"></div>
        </div>

        <!-- ═══════════════════ BROWSE ═══════════════════ -->
        <div class="bg-panel border border-border rounded-xl p-4 mb-6">
          <h2 class="text-xs font-semibold text-muted uppercase tracking-wide mb-3">
            <i class="fa-solid fa-globe text-blue mr-1"></i> Browse URL
          </h2>
          <div class="flex gap-2">
            <input
              type="url"
              id="browseInput"
              placeholder="https://example.com"
              class="flex-1 bg-bg border border-border rounded-lg px-3 py-2 text-sm font-mono text-text placeholder-muted focus:outline-none focus:border-brand transition"
            />
            <button id="browseSendBtn" class="cmd-btn">
              <i class="fa-solid fa-paper-plane"></i> Open
            </button>
          </div>
        </div>

        <!-- ═══════════════════ SCREENSHOTS ═══════════════════ -->
        <div class="bg-panel border border-border rounded-xl p-4 mb-6">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-xs font-semibold text-muted uppercase tracking-wide">
              <i class="fa-solid fa-camera text-brand mr-1"></i> Screenshots
            </h2>
            <div class="flex gap-2">
              <button id="screenshotBtn" class="cmd-btn text-xs">
                <i class="fa-solid fa-camera"></i> Capture
              </button>
              <button id="loadScreenshotsBtn" class="cmd-btn text-xs">
                <i class="fa-solid fa-arrows-rotate"></i> Load
              </button>
            </div>
          </div>
          <div id="screenshotGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
            <div class="text-muted text-xs text-center py-4">Click "Load" to view screenshots</div>
          </div>
        </div>

        <!-- ═══════════════════ COMMAND QUEUE & HISTORY ═══════════════════ -->
        <div class="bg-panel border border-border rounded-xl p-4 mb-6">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-xs font-semibold text-muted uppercase tracking-wide">
              <i class="fa-solid fa-list-check text-brand mr-1"></i> Command Queue & History
            </h2>
            <div class="flex gap-2">
              <button id="refreshQueueBtn" class="cmd-btn text-xs">
                <i class="fa-solid fa-arrows-rotate"></i> Refresh
              </button>
              <button id="flushQueueBtn" class="cmd-btn text-xs">
                <i class="fa-solid fa-trash text-red"></i> Flush Queue
              </button>
            </div>
          </div>

          <!-- Pending -->
          <div class="mb-4">
            <h3 class="text-xs font-semibold text-yellow mb-2">Pending (<span id="pendingCount">0</span>)</h3>
            <div id="pendingList" class="space-y-1">
              <div class="text-muted text-xs">No pending commands</div>
            </div>
          </div>

          <!-- History -->
          <div>
            <h3 class="text-xs font-semibold text-muted mb-2">Recent History</h3>
            <div id="historyList" class="space-y-1 max-h-[300px] overflow-auto">
              <div class="text-muted text-xs">No history</div>
            </div>
          </div>
        </div>

      </div>
    </section>
  </div>

</Layout>

<!-- ═══════════════════════════════════ STYLES ═══════════════════════════════════ -->
<style>
  .cmd-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .cmd-btn:hover {
    border-color: var(--color-brand);
    background: rgba(237, 35, 42, 0.08);
  }
  .cmd-btn:active {
    transform: scale(0.97);
  }
  .cmd-btn:disabled {
    opacity: 0.4;
    pointer-events: none;
  }
  .cmd-btn.sending {
    opacity: 0.6;
    pointer-events: none;
  }

  .queue-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
  }

  .history-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
  }

  .screenshot-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    text-align: center;
  }
  .screenshot-card img {
    width: 100%;
    height: auto;
    display: block;
  }
  .screenshot-card .label {
    padding: 0.375rem;
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-muted);
  }
</style>

<!-- ═══════════════════════════════════ JAVASCRIPT ═══════════════════════════════════ -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const CONTROL_URL = '/.netlify/functions/cluster-control';
    const STATUS_URL = '/.netlify/functions/cluster-status';

    const loginGate = document.getElementById('loginGate')!;
    const controlPanel = document.getElementById('controlPanel')!;
    const loginForm = document.getElementById('loginForm')!;
    const loginPassword = document.getElementById('loginPassword') as HTMLInputElement;
    const loginError = document.getElementById('loginError')!;
    const logoutBtn = document.getElementById('logoutBtn')!;
    const targetSelect = document.getElementById('targetSelect') as HTMLSelectElement;
    const toast = document.getElementById('toast')!;
    const toastMsg = document.getElementById('toastMsg')!;

    // ─── Auth ───
    function getPassword(): string | null {
      return sessionStorage.getItem('cluster-password');
    }

    function showPanel() {
      loginGate.classList.add('hidden');
      controlPanel.classList.remove('hidden');
      loadQueueAndHistory();
      checkPollerStatus();
    }

    function showLogin() {
      sessionStorage.removeItem('cluster-password');
      loginGate.classList.remove('hidden');
      controlPanel.classList.add('hidden');
    }

    // Check if already logged in
    if (getPassword()) {
      showPanel();
    }

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pw = loginPassword.value.trim();
      if (!pw) return;
      loginError.classList.add('hidden');

      // Validate password by making a test request
      try {
        const res = await fetch(CONTROL_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ command: 'screenshot', target: 'node1', password: pw })
        });
        if (res.status === 401) {
          loginError.classList.remove('hidden');
          return;
        }
        // Password works (even if 503/other - password was accepted)
        sessionStorage.setItem('cluster-password', pw);
        showPanel();
      } catch {
        // Network error - store password and hope for the best
        sessionStorage.setItem('cluster-password', pw);
        showPanel();
      }
    });

    logoutBtn.addEventListener('click', showLogin);

    // ─── Toast ───
    let toastTimer: ReturnType<typeof setTimeout>;
    function showToast(msg: string, type: 'success' | 'error' | 'info' = 'info') {
      toastMsg.textContent = msg;
      toast.className = 'fixed top-4 right-4 z-50 bg-panel border rounded-xl px-4 py-3 shadow-xl text-sm max-w-sm';
      if (type === 'success') toast.classList.add('border-green', 'text-green');
      else if (type === 'error') toast.classList.add('border-red', 'text-red');
      else toast.classList.add('border-border', 'text-text');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { toast.classList.add('hidden'); }, 4000);
    }

    // ─── Send Command ───
    async function sendCommand(command: string, extra: Record<string, any> = {}): Promise<any> {
      const pw = getPassword();
      if (!pw) { showLogin(); return null; }
      const target = targetSelect.value;

      const body: Record<string, any> = { command, target, password: pw, ...extra };

      try {
        const res = await fetch(CONTROL_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        if (res.status === 401) {
          showToast('Session expired. Please login again.', 'error');
          showLogin();
          return null;
        }

        const data = await res.json();
        if (data.success) {
          showToast(`${command} queued for ${target} (ID: ${data.id?.slice(0, 8)})`, 'success');
          loadQueueAndHistory();
          if (data.id) pollCommandResult(data.id);
        } else {
          showToast(data.error || 'Command failed', 'error');
        }
        return data;
      } catch (err) {
        showToast('Network error sending command', 'error');
        return null;
      }
    }

    // ─── Poll for result ───
    async function pollCommandResult(cmdId: string) {
      let attempts = 0;
      const maxAttempts = 30; // 30 * 2s = 60s
      const poll = async () => {
        attempts++;
        if (attempts > maxAttempts) return;
        try {
          const res = await fetch(`${CONTROL_URL}?action=command-status&id=${cmdId}`);
          const data = await res.json();
          if (data.status === 'completed') {
            showToast(`Command ${cmdId.slice(0, 8)} completed`, 'success');
            loadQueueAndHistory();
            // Show SSH output if available
            if (data.output) {
              const sshOutput = document.getElementById('sshOutput')!;
              sshOutput.textContent = data.output;
              sshOutput.classList.remove('hidden');
            }
            return;
          }
          if (data.status === 'queued' || data.status === 'executing') {
            setTimeout(poll, 2000);
          }
        } catch { /* retry */ setTimeout(poll, 3000); }
      };
      setTimeout(poll, 2000);
    }

    // ─── Quick Action Buttons ───
    document.querySelectorAll('.cmd-btn[data-cmd]').forEach(btn => {
      btn.addEventListener('click', () => {
        const cmd = (btn as HTMLElement).dataset.cmd!;
        btn.classList.add('sending');
        sendCommand(cmd).finally(() => btn.classList.remove('sending'));
      });
    });

    // ─── Display Mode Buttons ───
    document.querySelectorAll('.display-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = (btn as HTMLElement).dataset.mode!;
        btn.classList.add('sending');
        sendCommand('display-mode', { displayMode: mode }).finally(() => btn.classList.remove('sending'));
      });
    });

    // ─── Mining Level ───
    const miningLevel = document.getElementById('miningLevel') as HTMLInputElement;
    const miningLevelVal = document.getElementById('miningLevelVal')!;
    miningLevel.addEventListener('input', () => { miningLevelVal.textContent = miningLevel.value; });
    document.getElementById('miningLevelBtn')!.addEventListener('click', () => {
      sendCommand('mining-level', { miningLevel: parseInt(miningLevel.value) });
    });

    // ─── Brightness ───
    const brightnessSlider = document.getElementById('brightnessSlider') as HTMLInputElement;
    const brightnessVal = document.getElementById('brightnessVal')!;
    brightnessSlider.addEventListener('input', () => { brightnessVal.textContent = brightnessSlider.value; });
    document.getElementById('brightnessBtn')!.addEventListener('click', () => {
      sendCommand('brightness', { sshCmd: brightnessSlider.value });
    });

    // ─── SSH ───
    const sshInput = document.getElementById('sshInput') as HTMLInputElement;
    const sshOutput = document.getElementById('sshOutput')!;
    document.getElementById('sshSendBtn')!.addEventListener('click', () => {
      const cmd = sshInput.value.trim();
      if (!cmd) return;
      sshOutput.textContent = 'Sending command...';
      sshOutput.classList.remove('hidden');
      sendCommand('ssh', { sshCmd: cmd });
    });
    sshInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') document.getElementById('sshSendBtn')!.click();
    });

    // ─── Browse ───
    document.getElementById('browseSendBtn')!.addEventListener('click', () => {
      const url = (document.getElementById('browseInput') as HTMLInputElement).value.trim();
      if (!url) return;
      sendCommand('browse', { url });
    });

    // ─── Screenshots ───
    document.getElementById('screenshotBtn')!.addEventListener('click', () => {
      sendCommand('screenshot');
    });

    document.getElementById('loadScreenshotsBtn')!.addEventListener('click', loadScreenshots);

    async function loadScreenshots() {
      const grid = document.getElementById('screenshotGrid')!;
      grid.innerHTML = '<div class="text-muted text-xs text-center py-4 col-span-full">Loading...</div>';
      try {
        const res = await fetch(`${CONTROL_URL}?action=screenshots`);
        const data = await res.json();
        if (!data.screens || data.screens.length === 0) {
          grid.innerHTML = '<div class="text-muted text-xs text-center py-4 col-span-full">No screenshots available</div>';
          return;
        }
        grid.innerHTML = data.screens.map((s: any) => {
          if (!s.image) {
            return `<div class="screenshot-card">
              <div class="py-6 text-muted text-xs"><i class="fa-solid fa-image-slash"></i></div>
              <div class="label">${s.device}</div>
            </div>`;
          }
          return `<div class="screenshot-card">
            <img src="data:image/png;base64,${s.image}" alt="${s.device} screenshot" loading="lazy" />
            <div class="label">${s.device} <span class="text-muted font-normal">${s.timestamp ? new Date(s.timestamp).toLocaleTimeString() : ''}</span></div>
          </div>`;
        }).join('');
      } catch {
        grid.innerHTML = '<div class="text-muted text-xs text-center py-4 col-span-full">Failed to load screenshots</div>';
      }
    }

    // ─── Queue & History ───
    async function loadQueueAndHistory() {
      try {
        const res = await fetch(CONTROL_URL);
        const data = await res.json();

        // Pending
        const pendingCount = document.getElementById('pendingCount')!;
        const pendingList = document.getElementById('pendingList')!;
        pendingCount.textContent = String(data.pending || 0);
        if (data.queue && data.queue.length > 0) {
          pendingList.innerHTML = data.queue.map((c: any) => `
            <div class="queue-item">
              <i class="fa-solid fa-clock text-yellow"></i>
              <span class="font-mono font-bold">${c.command}</span>
              <span class="text-muted">&rarr; ${c.target}</span>
              <span class="text-muted ml-auto">${new Date(c.queuedAt).toLocaleTimeString()}</span>
            </div>
          `).join('');
        } else {
          pendingList.innerHTML = '<div class="text-muted text-xs">No pending commands</div>';
        }

        // History
        const historyList = document.getElementById('historyList')!;
        if (data.history && data.history.length > 0) {
          historyList.innerHTML = data.history.reverse().map((h: any) => {
            const isError = h.result && (h.result.includes('error') || h.result.includes('failed') || h.result.includes('expired'));
            return `<div class="history-item">
              <i class="fa-solid fa-${isError ? 'xmark text-red' : 'check text-green'}"></i>
              <div class="flex-1">
                <div><span class="font-mono font-bold">${h.command || h.id?.slice(0, 8)}</span> <span class="text-muted">&rarr; ${h.target || 'all'}</span></div>
                ${h.result ? `<div class="text-muted mt-0.5">${h.result.length > 120 ? h.result.slice(0, 120) + '...' : h.result}</div>` : ''}
                ${h.output ? `<details class="mt-1"><summary class="text-muted cursor-pointer hover:text-text text-[0.65rem]">Output</summary><pre class="text-[0.65rem] text-muted mt-1 whitespace-pre-wrap max-h-[150px] overflow-auto">${h.output}</pre></details>` : ''}
              </div>
              <span class="text-muted text-[0.65rem] whitespace-nowrap">${h.completedAt ? new Date(h.completedAt).toLocaleTimeString() : ''}</span>
            </div>`;
          }).join('');
        } else {
          historyList.innerHTML = '<div class="text-muted text-xs">No history</div>';
        }
      } catch {
        // silent
      }
    }

    document.getElementById('refreshQueueBtn')!.addEventListener('click', loadQueueAndHistory);
    document.getElementById('flushQueueBtn')!.addEventListener('click', async () => {
      try {
        const res = await fetch(`${CONTROL_URL}?action=flush-queue`);
        const data = await res.json();
        showToast(data.message || 'Queue flushed', 'success');
        loadQueueAndHistory();
      } catch {
        showToast('Failed to flush queue', 'error');
      }
    });

    // ─── Poller Status ───
    async function checkPollerStatus() {
      const dot = document.getElementById('pollerDot')!;
      const text = document.getElementById('pollerText')!;
      try {
        const res = await fetch(`${CONTROL_URL}?action=poller-status`);
        const data = await res.json();
        if (data.alive) {
          dot.style.background = '#22c55e';
          dot.style.boxShadow = '0 0 6px rgba(34,197,94,0.4)';
          text.textContent = `Poller alive (${data.ageSeconds}s ago)`;
          text.style.color = '#22c55e';
        } else {
          dot.style.background = '#ef4444';
          text.textContent = data.lastPoll ? `Poller dead (last: ${new Date(data.lastPoll).toLocaleTimeString()})` : 'Poller never connected';
          text.style.color = '#ef4444';
        }
      } catch {
        dot.style.background = '#ef4444';
        text.textContent = 'Poller status unknown';
        text.style.color = '#ef4444';
      }
    }

    // Refresh poller status every 15 seconds
    setInterval(checkPollerStatus, 15000);
    // Refresh queue every 10 seconds
    setInterval(() => { if (getPassword()) loadQueueAndHistory(); }, 10000);
  });
</script>
