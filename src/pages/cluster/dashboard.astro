function renderCommandTargets() {
  const sel = document.getElementById('cmdTarget');
  if (!sel) return;
  // Preserve current selection
  const current = sel.value;
  // Remove any previously added device options (keep first 3 static options)
  while (sel.options.length > 3) sel.remove(3);
  // Add separator then registered devices
  if (state.devices.length) {
    const sep = document.createElement('option');
    sep.disabled = true;
    sep.textContent = '── Registered Devices ──';
    sel.appendChild(sep);
    for (const d of state.devices) {
      const opt = document.createElement('option');
      opt.value = d.id;
      opt.textContent = `${d.hostname} (${d.device_class}) ${d.online ? '●' : '○'}`;
      sel.appendChild(opt);
    }
  }
  // Restore selection if still valid
  if (current && Array.from(sel.options).some(o => o.value === current)) sel.value = current;
}

async function lockBinaryHash() {
  const hash = document.getElementById('hashInput').value.trim();
  const target = document.getElementById('hashTarget').value;
  if (!/^[a-f0-9]{64}$/i.test(hash)) { toast('Hash must be 64 hex chars', 'error'); return; }
  try {
    const r = await callApi('set-binary-hash', 'POST', { hash, target });
    toast(`Hash locked on ${r.affected} device(s)`);
    document.getElementById('hashInput').value = '';
    setTimeout(fetchAll, 800);
  } catch (e) { toast(`Lock failed: ${e.message}`, 'error'); }
}

async function clearBinaryHash() {
  const target = document.getElementById('hashTarget').value;
  if (!confirm(`Clear binary hash enforcement for target: ${target}?`)) return;
  try {
    const r = await callApi('clear-binary-hash', 'POST', { target });
    toast(`Hash cleared on ${r.affected} device(s)`);
  } catch (e) { toast(`Clear failed: ${e.message}`, 'error'); }
}

function renderHashReport() {
  const el = document.getElementById('hashReport');
  if (!el) return;
  const hashes = {};
  for (const d of state.devices) {
    const h = d.observed?.binary_hash;
    if (h) hashes[h] = (hashes[h] || []);
    if (h) hashes[h].push(d.hostname);
  }
  const entries = Object.entries(hashes);
  if (!entries.length) { el.textContent = 'No observed hashes yet'; return; }
  el.innerHTML = entries.map(([h, hosts]) =>
    `<div style="margin:2px 0;display:flex;gap:8px;align-items:center">
      <span title="${h}" style="cursor:pointer" onclick="document.getElementById('hashInput').value='${h}'">${h.slice(0,16)}… (${hosts.join(', ')})</span>
      <button onclick="document.getElementById('hashInput').value='${h}'" style="background:transparent;border:1px solid var(--color-border);border-radius:3px;padding:1px 6px;cursor:pointer;font-size:10px;color:var(--color-muted)">Use</button>
    </div>`
  ).join('');
}

