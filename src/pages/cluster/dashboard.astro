      </div>

      <h3 style="margin-top:20px;margin-bottom:8px">Recent Events</h3>
      <div id="deviceEvents" style="font-size:12px;max-height:200px;overflow-y:auto">Loading...</div>
    `;
    detail.style.right = '0';
    loadDeviceEvents(deviceId);
  } catch (e) { toast(`Error: ${e.message}`, 'error'); }
}

