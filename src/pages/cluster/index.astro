---
import Layout from '../../layouts/Layout.astro';

const fleet = [
  { count: '08', title: 'Android phones', icon: 'fa-brands fa-android', detail: 'Termux workers for lightweight retrieval and website checks.', names: 'Eight phone workers', color: 'text-green' },
  { count: '04', title: 'Linux systems', icon: 'fa-brands fa-linux', detail: 'Browser audits, local AI and coordination across the network.', names: 'Alina · Nexus · Steam Deck · viki', color: 'text-blue' },
  { count: '01', title: 'Windows workstation', icon: 'fa-brands fa-windows', detail: 'Media production on the RenderRig workstation.', names: 'RenderRig', color: 'text-brand' },
];
const workloads = [
  { icon: 'fa-solid fa-magnifying-glass', title: 'Research & retrieval', text: 'Phone workers gather information and run lightweight website checks.' },
  { icon: 'fa-solid fa-window-maximize', title: 'Browser audits & local AI', text: 'Linux systems handle browser work and local AI workloads.' },
  { icon: 'fa-solid fa-photo-film', title: 'Media production', text: 'RenderRig handles media tasks while the dashboard collects worker reports.' },
];
const workers = ['phone173', 'phone174', 'phone176', 'phone177', 'phone191', 'phone195', 'phone253', 'phone254', 'Alina', 'Nexus', 'SteamDeck', 'viki', 'RenderRig'];
---

<Layout title="Compute Cluster - Curtis Bragdon" description="Explore Curtis Bragdon's 13-device compute fleet: eight Android phones, four Linux systems and one Windows workstation working together on research, browser audits and media production.">
  <section class="cluster-hero">
    <div class="cluster-wrap hero-grid">
      <div>
        <p class="eyebrow"><i class="fa-solid fa-network-wired" aria-hidden="true"></i> THE COMPUTE FLEET</p>
        <h1>Small devices.<br /><span class="gradient-text">Shared ambition.</span></h1>
        <p class="hero-copy">Thirteen devices working together on research, website checks, local AI and media production. One dashboard to coordinate the work.</p>
        <div class="hero-actions">
          <a class="primary-link" href="/cluster/dashboard/">Open work dashboard <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          <a class="secondary-link" href="#fleet">Explore the fleet <i class="fa-solid fa-arrow-down" aria-hidden="true"></i></a>
        </div>
        <p class="dashboard-note"><i class="fa-solid fa-lock" aria-hidden="true"></i> Dashboard sign-in required for worker status, assignments and reports.</p>
      </div>
      <div class="fleet-visual" aria-label="Fleet composition: eight Android phones, four Linux systems and one Windows workstation">
        <div class="visual-header"><span>FLEET COMPOSITION</span><span class="visual-tag">13 DEVICES</span></div>
        <div class="device-matrix" aria-hidden="true">
          {Array.from({ length: 13 }, (_, i) => <div class:list={['device-tile', i < 8 ? 'phone' : i < 12 ? 'linux' : 'windows']}><i class={i < 8 ? 'fa-solid fa-mobile-screen-button' : i < 12 ? 'fa-solid fa-laptop' : 'fa-solid fa-desktop'}></i></div>)}
        </div>
        <div class="visual-legend"><span><b class="text-green">8</b> Android</span><span><b class="text-blue">4</b> Linux</span><span><b class="text-brand">1</b> Windows</span></div>
        <p class="visual-footnote">Device inventory · live availability is in the dashboard</p>
      </div>
    </div>
  </section>

  <section class="cluster-section cluster-wrap" aria-labelledby="connections-heading">
    <div class="connection-heading"><div class="section-heading"><p class="eyebrow">LIVE CONNECTIONS</p><h2 id="connections-heading">Worker availability</h2><p>Recent worker check-ins, refreshed every 30 seconds.</p></div><button type="button" id="connection-refresh" class="secondary-link">Refresh status <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i></button></div>
    <p id="connection-summary" class="connection-summary" role="status">Checking worker connections…</p>
    <div class="connection-grid">
      {workers.map(worker => <article class="connection-card" data-worker={worker} data-state="unknown"><h3>{worker}</h3><p data-connection-status>Checking…</p><small data-connection-age>Waiting for a response</small></article>)}
    </div>
    <p class="connection-note">Online means a worker checked in within 90 seconds. Unavailable means its status could not be verified. Work assignments and controls are in the <a href="/cluster/dashboard/">work dashboard</a>.</p>
    <noscript><p class="connection-note">Enable JavaScript to see live connections, or open the work dashboard.</p></noscript>
  </section>

  <section id="fleet" class="cluster-section cluster-wrap">
    <div class="section-heading"><p class="eyebrow">BUILT TO WORK TOGETHER</p><h2>Meet the fleet</h2><p>A hybrid setup, with each device group contributing its strengths.</p></div>
    <div class="three-grid">
      {fleet.map(group => <article class="fleet-card"><div class="card-top"><i class={`${group.icon} ${group.color}`} aria-hidden="true"></i><span class="device-count">{group.count}</span></div><h3>{group.title}</h3><p>{group.detail}</p><div class="device-names">{group.names}</div></article>)}
    </div>
  </section>

  <section class="cluster-section cluster-wrap">
    <div class="section-heading"><p class="eyebrow">PURPOSEFUL WORKLOADS</p><h2>What the cluster does</h2></div>
    <div class="three-grid">
      {workloads.map(work => <article class="work-card"><i class={`${work.icon} text-brand`} aria-hidden="true"></i><h3>{work.title}</h3><p>{work.text}</p></article>)}
    </div>
    <div class="policy-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>Mining is disabled by operating policy. The fleet is focused on coordinated compute workloads.</p></div>
  </section>

  <section class="cluster-wrap cluster-section">
    <div class="dashboard-callout"><div><p class="eyebrow">THE CONTROL CENTER</p><h2>See the work in progress.</h2><p>Check current worker availability, assign work and review collected reports in the password-protected dashboard.</p></div><a class="primary-link" href="/cluster/dashboard/">Open work dashboard <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
  </section>
</Layout>

<script is:inline>
(() => {
  const cards = [...document.querySelectorAll('[data-worker]')];
  const refresh = document.getElementById('connection-refresh');
  const summary = document.getElementById('connection-summary');
  const snapshots = new Map();
  let busy = false;
  let completed = false;
  function render() {
    let online = 0, offline = 0, unavailable = 0;
    for (const card of cards) {
      const item = snapshots.get(card.dataset.worker);
      let state = 'unknown', detail = 'Status could not be verified';
      if (item && Date.now() - item.received < 45000) {
        const age = item.checkedAt - item.lastSeen + Date.now() - item.received;
        if (item.lastSeen === null) detail = 'No worker check-in recorded';
        else if (age >= -5000) {
          state = age < 90000 ? 'online' : 'offline';
          const seconds = Math.max(0, Math.floor(age / 1000));
          detail = seconds < 60 ? `Checked in ${seconds}s ago` : seconds < 3600 ? `Checked in ${Math.floor(seconds / 60)}m ago` : seconds < 86400 ? `Checked in ${Math.floor(seconds / 3600)}h ago` : `Checked in ${Math.floor(seconds / 86400)}d ago`;
        }
      }
      if (state === 'online') online++;
      else if (state === 'offline') offline++;
      else unavailable++;
      card.dataset.state = state;
      card.querySelector('[data-connection-status]').textContent = state === 'online' ? 'Online' : state === 'offline' ? 'Offline' : 'Unavailable';
      card.querySelector('[data-connection-age]').textContent = detail;
    }
    if (completed) summary.textContent = `${online} of ${cards.length} workers online · ${offline} offline · ${unavailable} unavailable`;
  }
  async function update() {
    if (busy || document.hidden) return;
    busy = true; refresh.disabled = true; refresh.textContent = 'Checking…';
    try {
      await Promise.allSettled(cards.map(async card => {
        const unit = card.dataset.worker;
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 8000);
        try {
          const response = await fetch('/.netlify/functions/phone-display?phone=' + encodeURIComponent(unit) + '&activity=1', {cache:'no-store', signal:controller.signal});
          if (!response.ok) throw new Error('Status unavailable');
          const data = (await response.json()).activity;
          if (!data || data.unit !== unit || !Number.isFinite(data.checkedAt) || !(data.lastSeen === null || Number.isFinite(data.lastSeen))) throw new Error('Invalid status');
          snapshots.set(unit, {lastSeen:data.lastSeen, checkedAt:data.checkedAt, received:Date.now()});
        } catch { snapshots.delete(unit); }
        finally { clearTimeout(timeout); }
      }));
      completed = true; render();
    } finally { busy = false; refresh.disabled = false; refresh.textContent = 'Refresh status'; }
  }
  refresh.addEventListener('click', update);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) { render(); update(); } });
  setInterval(update, 30000);
  setInterval(() => { if (!document.hidden && completed) render(); }, 1000);
  update();
})();
</script>

<style>
  .connection-heading{display:flex;justify-content:space-between;gap:20px;align-items:center;flex-wrap:wrap}.connection-heading button{cursor:pointer}.connection-heading button:disabled{opacity:.6;cursor:wait}.connection-summary{color:var(--color-text-secondary);font-size:14px;margin-bottom:20px}.connection-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.connection-card{border:1px solid var(--color-border);border-radius:12px;padding:18px;background:var(--color-panel)}.connection-card h3{font-size:14px;overflow-wrap:anywhere}.connection-card p{font-size:13px;color:var(--color-muted);margin-bottom:8px}.connection-card p:before{content:'';display:inline-block;width:7px;height:7px;border-radius:50%;background:currentColor;margin-right:8px}.connection-card[data-state=online] p{color:#4ade80}.connection-card[data-state=offline] p{color:#ff8b87}.connection-card small{font-size:10px;color:var(--color-muted)}.connection-note{font-size:12px;color:var(--color-muted);margin-top:18px;line-height:1.8}.connection-note a{color:var(--color-text-secondary);text-decoration:underline}@media(max-width:640px){.connection-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.connection-card{padding:14px}}
  .cluster-wrap{max-width:1152px;margin:0 auto;padding-left:24px;padding-right:24px}
  .cluster-hero{padding:88px 0 72px;background:radial-gradient(ellipse at 85% 35%,rgba(237,35,42,.09),transparent 55%)}
  .hero-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:64px;align-items:center}
  .eyebrow{font-size:11px;font-weight:700;letter-spacing:.16em;color:var(--color-brand);margin-bottom:16px;display:flex;gap:10px;align-items:center}
  h1{font-size:clamp(36px,4.6vw,58px);font-weight:800;line-height:1.12;letter-spacing:-.035em;margin-bottom:24px}
  .hero-copy{font-size:17px;color:var(--color-text-secondary);max-width:560px;line-height:1.8}
  .hero-actions{display:flex;flex-wrap:wrap;gap:18px;align-items:center;margin-top:30px}
  .primary-link{display:inline-flex;align-items:center;justify-content:center;gap:14px;padding:14px 20px;border-radius:10px;background:var(--color-brand);color:white;font-size:14px;font-weight:700;transition:background .2s;min-height:48px}
  .primary-link:hover{background:var(--color-brand-dark)}
  .secondary-link{display:inline-flex;align-items:center;gap:10px;font-size:13px;padding:12px 0;color:var(--color-text-secondary)}
  .secondary-link:hover{color:white}
  .dashboard-note{font-size:11px;color:var(--color-muted);margin-top:18px;line-height:1.7}
  .dashboard-note i{margin-right:5px}
  .fleet-visual{border:1px solid var(--color-border);border-radius:20px;padding:28px;background:linear-gradient(145deg,#191b20,#101114);box-shadow:0 20px 70px #0004}
  .visual-header{display:flex;justify-content:space-between;gap:12px;align-items:center;font-size:10px;letter-spacing:.12em;color:var(--color-muted);font-weight:600}
  .visual-tag{border:1px solid var(--color-border);border-radius:6px;padding:5px 8px;white-space:nowrap;color:var(--color-text)}
  .device-matrix{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:28px 0}
  .device-tile{height:62px;border-radius:10px;display:grid;place-items:center;border:1px solid #ffffff12;font-size:23px}
  .phone{color:#4ade80;background:#22c55e0b}.linux{color:#60a5fa;background:#3b82f60b}.windows{color:#ff666c;background:#ed232a12;grid-column:1/-1;height:54px}
  .visual-legend{display:flex;justify-content:space-between;gap:10px;font-size:12px;color:var(--color-text-secondary)}
  .visual-legend b{margin-right:4px}.visual-footnote{font-size:10px;color:var(--color-muted);text-align:center;margin-top:20px}
  .cluster-section{padding-top:38px;padding-bottom:38px;scroll-margin-top:100px}
  .section-heading{margin-bottom:24px}.section-heading .eyebrow{margin-bottom:10px}h2{font-size:clamp(25px,3vw,32px);font-weight:700;letter-spacing:-.02em;line-height:1.3}
  .section-heading>p:last-child:not(.eyebrow){color:var(--color-muted);font-size:14px;margin-top:10px}
  .three-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .fleet-card{background:var(--color-panel);border:1px solid var(--color-border);border-radius:14px;padding:26px;display:flex;flex-direction:column}
  .card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}.card-top i{font-size:28px}.device-count{font-size:32px;font-weight:700;font-family:var(--font-mono);color:var(--color-text)}
  h3{font-size:17px;font-weight:700;margin-bottom:10px}.fleet-card>p,.work-card>p{font-size:13px;color:var(--color-text-secondary);line-height:1.8}
  .device-names{margin-top:auto;padding-top:24px;color:var(--color-muted);font-size:11px}
  .work-card{padding:20px 0}.work-card>i{font-size:22px;margin-bottom:18px}.work-card h3{font-size:16px}
  .policy-note{display:flex;gap:12px;align-items:baseline;border-top:1px solid var(--color-border);padding-top:20px;margin-top:10px;font-size:12px;color:var(--color-muted)}
  .dashboard-callout{background:var(--color-panel);border:1px solid var(--color-border);border-radius:18px;padding:36px;display:flex;align-items:center;justify-content:space-between;gap:32px;margin-bottom:32px}
  .dashboard-callout p:last-child{font-size:13px;color:var(--color-text-secondary);margin-top:12px;max-width:620px}.dashboard-callout .primary-link{flex-shrink:0}
  @media(max-width:900px){.hero-grid{gap:32px;grid-template-columns:1fr 1fr}.cluster-hero{padding-top:54px}.fleet-visual{padding:20px}.fleet-card{padding:20px}.dashboard-callout{align-items:flex-start;flex-direction:column}}
  @media(max-width:640px){.cluster-wrap{padding-left:20px;padding-right:20px}.hero-grid,.three-grid{grid-template-columns:1fr}.hero-grid{gap:36px}.cluster-hero{padding:40px 0 24px}.cluster-section{padding-top:28px;padding-bottom:28px}.fleet-visual{padding:24px}.device-tile{height:52px}.device-matrix{margin:22px 0}.work-card{padding:10px 0}.dashboard-callout{padding:24px}.dashboard-callout .primary-link{width:100%}.hero-actions{gap:10px 18px}}
</style>
