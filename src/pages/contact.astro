---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact - Curtis Bragdon"
  description="Get in touch with Curtis Bragdon - schedule a truck stop, request tools, or ask any questions."
>
  <section class="max-w-xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6 reveal">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-brand transition">Home</a></li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs"></i></li>
        <li class="text-text" aria-current="page">Contact</li>
      </ol>
    </nav>

    <h1 class="text-3xl font-bold text-center mb-8 text-text reveal">
      <i class="fa-solid fa-envelope text-brand mr-2" aria-hidden="true"></i>Contact <span class="gradient-text">Curtis</span>
    </h1>

    <!-- Business Info -->
    <div class="card-glow p-6 mb-6 reveal">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div>
          <h2 class="font-semibold text-text mb-2"><i class="fa-solid fa-clock text-brand mr-2" aria-hidden="true"></i>Hours</h2>
          <p class="text-text-secondary">Monday &ndash; Friday: 7:00 AM &ndash; 5:00 PM</p>
          <p class="text-muted text-xs mt-1">Weekends by appointment</p>
        </div>
        <div>
          <h2 class="font-semibold text-text mb-2"><i class="fa-solid fa-map-marker-alt text-brand mr-2" aria-hidden="true"></i>Service Area</h2>
          <p class="text-text-secondary">Boston metro area, MA</p>
          <p class="text-muted text-xs mt-1">Lynn, Revere, Malden, Everett, and surrounding towns</p>
        </div>
        <div>
          <h2 class="font-semibold text-text mb-2"><i class="fa-solid fa-phone text-brand mr-2" aria-hidden="true"></i>Phone</h2>
          <a href="tel:+17814170692" class="text-text-secondary hover:text-brand transition">781-417-0692</a>
        </div>
        <div>
          <h2 class="font-semibold text-text mb-2"><i class="fa-solid fa-envelope text-brand mr-2" aria-hidden="true"></i>Email</h2>
          <a href="mailto:curtbrag@yahoo.com" class="text-text-secondary hover:text-brand transition">curtbrag@yahoo.com</a>
        </div>
      </div>
    </div>

    <div class="card-glow p-8 reveal">
      <p class="text-text-secondary leading-relaxed mb-6">
        Have a question about tools, need a custom order, or want to schedule a stop? Fill out the form below or use the quick contact options.
      </p>

      <!-- Quick Contact Buttons -->
      <div class="flex flex-wrap gap-3 mb-6 pb-6 border-b border-border stagger-children">
        <a
          href="tel:+17814170692"
          class="inline-flex items-center gap-2 px-4 py-2 bg-bg border border-border rounded-lg text-text text-sm hover:border-brand hover:bg-brand/10 hover:scale-105 transition-all duration-200"
        >
          <i class="fa-solid fa-phone"></i>Call
        </a>
        <a
          href="sms:+17814170692"
          class="inline-flex items-center gap-2 px-4 py-2 bg-bg border border-border rounded-lg text-text text-sm hover:border-brand hover:bg-brand/10 hover:scale-105 transition-all duration-200"
        >
          <i class="fa-solid fa-comment-sms"></i>Text
        </a>
        <a
          href="mailto:curtbrag@yahoo.com"
          class="inline-flex items-center gap-2 px-4 py-2 bg-bg border border-border rounded-lg text-text text-sm hover:border-brand hover:bg-brand/10 hover:scale-105 transition-all duration-200"
        >
          <i class="fa-solid fa-envelope"></i>Email
        </a>
        <a
          href="/zelle"
          class="inline-flex items-center gap-2 px-4 py-2 bg-bg border border-border rounded-lg text-text text-sm hover:border-brand hover:bg-brand/10 hover:scale-105 transition-all duration-200"
        >
          <i class="fa-solid fa-dollar-sign"></i>Zelle
        </a>
        <button
          type="button"
          id="copy-phone-btn"
          class="inline-flex items-center gap-2 px-4 py-2 bg-bg border border-border rounded-lg text-text text-sm hover:border-brand hover:bg-brand/10 hover:scale-105 transition-all duration-200 cursor-pointer"
        >
          <i class="fa-solid fa-copy"></i>Copy #
        </button>
      </div>

      <!-- Contact Form -->
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks"
        id="contact-form"
        class="flex flex-col gap-4"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>
            Don't fill this out: <input name="bot-field" />
          </label>
        </p>

        <div>
          <label for="name" class="block text-sm font-semibold text-text-secondary mb-1">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full bg-bg border border-border rounded-lg px-4 py-3 text-text focus:border-brand focus:ring-2 focus:ring-brand/20 transition-all duration-200 outline-none"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold text-text-secondary mb-1">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full bg-bg border border-border rounded-lg px-4 py-3 text-text focus:border-brand focus:ring-2 focus:ring-brand/20 transition-all duration-200 outline-none"
          />
        </div>

        <div>
          <label for="subject" class="block text-sm font-semibold text-text-secondary mb-1">Subject</label>
          <input
            type="text"
            id="subject"
            name="subject"
            placeholder="Schedule Stop, Tool Request, Warranty, etc."
            class="w-full bg-bg border border-border rounded-lg px-4 py-3 text-text placeholder:text-muted focus:border-brand focus:ring-2 focus:ring-brand/20 transition-all duration-200 outline-none"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-semibold text-text-secondary mb-1">Message</label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            placeholder="How can I help you?"
            class="w-full bg-bg border border-border rounded-lg px-4 py-3 text-text placeholder:text-muted focus:border-brand focus:ring-2 focus:ring-brand/20 transition-all duration-200 outline-none resize-y"
          ></textarea>
        </div>

        <button
          type="submit"
          id="contact-submit"
          class="btn-brand w-full bg-brand text-white rounded-xl py-3 font-semibold hover:bg-brand-dark hover:scale-[1.02] transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-brand/20 hover:shadow-brand/40"
        >
          <span id="submit-text">Send Message</span>
          <i id="submit-spinner" class="fa-solid fa-spinner fa-spin hidden"></i>
        </button>
      </form>
    </div>
  </section>
</Layout>

<script>
  // Copy phone number
  const copyBtn = document.getElementById('copy-phone-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('781-417-0692');
        const icon = copyBtn.querySelector('i');
        const originalClass = icon?.className;
        if (icon) {
          icon.className = 'fa-solid fa-check';
        }
        copyBtn.querySelector('i')?.nextSibling && (copyBtn.lastChild!.textContent = 'Copied!');
        setTimeout(() => {
          if (icon && originalClass) icon.className = originalClass;
          if (copyBtn.lastChild) copyBtn.lastChild.textContent = 'Copy #';
        }, 2000);
      } catch {
        // Fallback for older browsers
        const textarea = document.createElement('textarea');
        textarea.value = '781-417-0692';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }
    });
  }

  // Form loading state
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('contact-submit');
  const submitText = document.getElementById('submit-text');
  const submitSpinner = document.getElementById('submit-spinner');

  if (form && submitBtn && submitText && submitSpinner) {
    form.addEventListener('submit', () => {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
      submitText.textContent = 'Sending...';
      submitSpinner.classList.remove('hidden');
    });
  }
</script>
