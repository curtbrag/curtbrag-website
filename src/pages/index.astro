          <i class="fa-brands fa-paypal"></i> Venmo
        </a>
        <a href="https://otis.curtbrag.com/curtspotify" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-surface border border-border rounded-lg px-4 py-2 text-sm hover:border-border-hover transition">
