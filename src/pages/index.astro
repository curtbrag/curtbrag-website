        </a>
        <a href="https://otis.curtbrag.com/curtzelle" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-surface border border-border rounded-lg px-4 py-2 text-sm hover:border-border-hover transition">
          <i class="fa-solid fa-money-bill"></i> Zelle
        </a>
        <a href="https://otis.curtbrag.com/curtcash" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-surface border border-border rounded-lg px-4 py-2 text-sm hover:border-border-hover transition">
          <i class="fa-brands fa-square-cash-app"></i> CashApp
        </a>
        <a href="https://otis.curtbrag.com/curtvenmo" target="_blank" rel="noopener noreferrer"
