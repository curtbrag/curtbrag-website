  <!-- ═══════════════════════════════════════ ALINA AI ═══════════════════════════════════════ -->
  <section class="py-14 md:py-20 reveal" id="alina">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Header -->
      <div class="flex items-center gap-3 mb-1">
        <img src="/assets/alina_avatar.png" alt="Alina AI" class="w-12 h-12 rounded-xl ring-2 ring-brand/30" loading="lazy" />
        <h2 class="text-2xl font-bold">Alina &mdash; <span class="gradient-text">AI Command Center</span></h2>
      </div>
      <p class="text-muted text-sm mb-6">
        GPT sessions 7,500+ &bull; Custom automations (Bitly, Netlify, DraftKings, more) &bull; Tool deals closed: infinity
      </p>

      <!-- Prompt Chips -->
      <div class="flex flex-wrap gap-2 mb-4" id="prompt-chips">
        <button data-prompt="Schedule a stop" class="alina-chip rounded-full border border-border bg-surface px-4 py-2 text-sm hover:border-brand hover:bg-brand/10 hover:scale-105 transition-all duration-200 cursor-pointer">Schedule</button>
        <button data-prompt="What promos are running?" class="alina-chip rounded-full border border-border bg-surface px-4 py-2 text-sm hover:border-brand hover:bg-brand/10 hover:scale-105 transition-all duration-200 cursor-pointer">Promos</button>
        <button data-prompt="How do I pay?" class="alina-chip rounded-full border border-border bg-surface px-4 py-2 text-sm hover:border-brand hover:bg-brand/10 hover:scale-105 transition-all duration-200 cursor-pointer">Pay</button>
        <button data-prompt="I need warranty help" class="alina-chip rounded-full border border-border bg-surface px-4 py-2 text-sm hover:border-brand hover:bg-brand/10 hover:scale-105 transition-all duration-200 cursor-pointer">Warranty</button>
        <button data-prompt="How do I contact Curt?" class="alina-chip rounded-full border border-border bg-surface px-4 py-2 text-sm hover:border-brand hover:bg-brand/10 hover:scale-105 transition-all duration-200 cursor-pointer">Contact</button>
        <button data-prompt="Tell me a joke" class="alina-chip rounded-full border border-border bg-surface px-4 py-2 text-sm hover:border-brand hover:bg-brand/10 hover:scale-105 transition-all duration-200 cursor-pointer">Joke</button>
      </div>

      <!-- Chat Widget -->
      <div class="bg-panel border border-border rounded-2xl p-4 hover:border-border-hover transition-colors duration-300">
        <div id="chat-log" class="bg-bg rounded-xl border border-border h-60 overflow-y-auto p-4 space-y-3">
