<!-- ═══════════════════════════════════ ALINA CHAT SCRIPT ═══════════════════════════════════ -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const chatLog = document.getElementById('chat-log');
    const userInput = document.getElementById('user-input') as HTMLInputElement;
    const sendBtn = document.getElementById('send-btn');
    const chips = document.querySelectorAll('.alina-chip');

    if (!chatLog || !userInput || !sendBtn) return;

    const conversationHistory: { role: string; content: string }[] = [];

    function appendMsg(who: string, text: string) {
      const wrapper = document.createElement('div');
      wrapper.className = who === 'user' ? 'flex justify-end' : 'flex justify-start';

      const bubble = document.createElement('div');
      bubble.className = who === 'user'
        ? 'max-w-[80%] rounded-xl px-4 py-2 text-sm bg-green-900/30 border border-green-800/40 text-text'
        : 'max-w-[80%] rounded-xl px-4 py-2 text-sm bg-surface border border-border text-text';
      bubble.textContent = text;

      wrapper.appendChild(bubble);
      chatLog!.appendChild(wrapper);
      chatLog!.scrollTop = chatLog!.scrollHeight;
    }

    async function askAlina(text: string): Promise<string> {
      try {
        conversationHistory.push({ role: 'user', content: text });
        const res = await fetch('/.netlify/functions/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text, history: conversationHistory.slice(-6) }),
        });
        const data = await res.json();
        const reply = data.reply || data.message || 'No response.';
        conversationHistory.push({ role: 'assistant', content: reply });
        return reply;
      } catch {
        return 'Alina is offline right now. Try again later.';
      }
    }

    function send() {
      const text = userInput.value.trim();
      if (!text) return;
      userInput.value = '';

      // Easter egg: clear chat
      if (text.toLowerCase() === '!refresh') {
        chatLog!.innerHTML = '';
        conversationHistory.length = 0;
        appendMsg('system', 'Alina here. What do you need?');
        return;
      }

      appendMsg('user', text);

      // Show typing indicator
      const typingId = 'typing-indicator';
      const typingWrapper = document.createElement('div');
      typingWrapper.className = 'flex justify-start';
      typingWrapper.id = typingId;
      const typingBubble = document.createElement('div');
      typingBubble.className = 'max-w-[80%] rounded-xl px-4 py-2 text-sm bg-surface border border-border text-muted italic';
      typingBubble.textContent = 'Alina is thinking...';
      typingWrapper.appendChild(typingBubble);
      chatLog!.appendChild(typingWrapper);
      chatLog!.scrollTop = chatLog!.scrollHeight;

      askAlina(text).then((reply) => {
        const indicator = document.getElementById(typingId);
        if (indicator) indicator.remove();
        appendMsg('system', reply);
      });
    }

    sendBtn.addEventListener('click', send);

    userInput.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        send();
      }
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const prompt = (chip as HTMLElement).getAttribute('data-prompt');
        if (prompt) {
          userInput.value = prompt;
          send();
        }
      });
    });
  });
</script>

<!-- ═══════════════════════════════════ SPORTS TRACKER SCRIPT ═══════════════════════════════════ -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const teamIds = ['redsox', 'patriots', 'celtics', 'bruins', 'revolution'];
    const statusEl = document.getElementById('sports-status');
    let loaded = false;

    async function loadSports() {
      try {
        const res = await fetch('/.netlify/functions/sports');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();

        if (!data.success || !data.teams) throw new Error('Scores unavailable');
        if (data.teams) {
          teamIds.forEach((team) => {
            const el = document.getElementById(`score-${team}`);
            if (el && data.teams[team]) {
              el.textContent = data.teams[team];
            } else if (el) {
              el.textContent = 'No game scheduled';
            }
          });
          loaded = true;
          if (statusEl) {
            const now = new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
            statusEl.textContent = (data.unavailable?.length ? 'Some scores unavailable. Last checked ' : 'Last checked ') + now;
          }
        }
      } catch {
        if (loaded && statusEl) statusEl.textContent = 'Update failed. Showing the last loaded scores; retrying automatically.';
        if (!loaded) {
          teamIds.forEach((team) => {
            const el = document.getElementById(`score-${team}`);
            if (el) el.textContent = 'Scores temporarily unavailable';
          });
          if (statusEl) statusEl.textContent = 'Scores could not be loaded. Retrying automatically.';
        }
      }
    }

    // Initial load
    loadSports();

    // Retry after 5 seconds in case the function cold-starts
    setTimeout(loadSports, 5000);

    // Auto-refresh every 5 minutes
    setInterval(loadSports, 300000);
  });
</script>

