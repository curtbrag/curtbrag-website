  <!-- ═══════════════════════════════════════ ALINA AI ═══════════════════════════════════════ -->
  <section class="py-12 md:py-16" id="alina">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Header -->
      <div class="flex items-center gap-3 mb-1">
        <img src="/assets/alina_avatar.png" alt="Alina AI" class="w-12 h-12 rounded-xl" loading="lazy" />
        <h2 class="text-2xl font-bold">Alina &mdash; AI Command Center</h2>
      </div>
      <p class="text-muted text-sm mb-6">
        GPT sessions 7,500+ &bull; Custom automations (Bitly, Netlify, DraftKings, more) &bull; Tool deals closed: infinity
      </p>

      <!-- Prompt Chips -->
      <div class="flex flex-wrap gap-2 mb-4" id="prompt-chips">
        <button data-prompt="Schedule a stop" class="alina-chip rounded-full border border-border bg-surface px-4 py-2 text-sm hover:border-brand-glow transition cursor-pointer">Schedule</button>
        <button data-prompt="What promos are running?" class="alina-chip rounded-full border border-border bg-surface px-4 py-2 text-sm hover:border-brand-glow transition cursor-pointer">Promos</button>
        <button data-prompt="How do I pay?" class="alina-chip rounded-full border border-border bg-surface px-4 py-2 text-sm hover:border-brand-glow transition cursor-pointer">Pay</button>
        <button data-prompt="I need warranty help" class="alina-chip rounded-full border border-border bg-surface px-4 py-2 text-sm hover:border-brand-glow transition cursor-pointer">Warranty</button>
        <button data-prompt="How do I contact Curt?" class="alina-chip rounded-full border border-border bg-surface px-4 py-2 text-sm hover:border-brand-glow transition cursor-pointer">Contact</button>
        <button data-prompt="Tell me a joke" class="alina-chip rounded-full border border-border bg-surface px-4 py-2 text-sm hover:border-brand-glow transition cursor-pointer">Joke</button>
      </div>

      <!-- Chat Widget -->
      <div class="bg-panel border border-border rounded-2xl p-4">
        <div id="chat-log" class="bg-bg rounded-xl border border-border h-60 overflow-y-auto p-4 space-y-3">
          <!-- System greeting -->
          <div class="flex justify-start">
            <div class="max-w-[80%] rounded-xl px-4 py-2 text-sm bg-surface border border-border text-text">
              Alina here. What do you need?
            </div>
          </div>
        </div>

        <!-- Input Bar -->
        <div class="flex gap-2 mt-3">
          <input
            type="text"
            id="user-input"
            placeholder="Ask Alina anything..."
            class="flex-1 bg-bg border border-border rounded-lg px-4 py-3 text-text placeholder:text-muted focus:outline-none focus:border-brand transition text-sm"
          />
          <button
            id="send-btn"
            class="bg-brand text-white rounded-lg px-5 py-3 font-semibold hover:bg-brand-dark transition text-sm"
