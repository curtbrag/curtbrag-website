---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Curtis Bragdon's World" description="Curtis Bragdon — Snap-on tools, service, custom AI and builds. Galleries, contact, and more.">

  <!-- ═══════════════════════════════════════════ HERO ═══════════════════════════════════════════ -->
  <section class="relative py-20 md:py-32 overflow-hidden">
    <!-- Animated gradient background -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-gradient-to-b from-brand/5 via-transparent to-transparent"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full bg-brand/8 blur-[150px] animate-gradient bg-gradient-to-br from-brand/10 via-red-500/5 to-transparent"></div>
      <div class="absolute top-1/4 right-1/4 w-[300px] h-[300px] rounded-full bg-blue/5 blur-[100px]"></div>
      <div class="absolute bottom-1/4 left-1/4 w-[200px] h-[200px] rounded-full bg-brand/5 blur-[80px]"></div>
    </div>

    <!-- Floating particles -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true" id="hero-particles">
      <div class="particle" style="top: 20%; left: 15%; --drift-x: 30px; --drift-y: -50px; --duration: 5s; --delay: 0s;"></div>
      <div class="particle" style="top: 60%; left: 80%; --drift-x: -40px; --drift-y: -70px; --duration: 7s; --delay: 1s;"></div>
      <div class="particle" style="top: 40%; left: 50%; --drift-x: 50px; --drift-y: -40px; --duration: 6s; --delay: 2s;"></div>
      <div class="particle" style="top: 70%; left: 30%; --drift-x: -20px; --drift-y: -80px; --duration: 8s; --delay: 0.5s;"></div>
      <div class="particle" style="top: 30%; left: 70%; --drift-x: 35px; --drift-y: -60px; --duration: 5.5s; --delay: 3s;"></div>
      <div class="particle" style="top: 80%; left: 60%; --drift-x: -30px; --drift-y: -90px; --duration: 9s; --delay: 1.5s;"></div>
      <div class="particle" style="top: 50%; left: 20%; --drift-x: 60px; --drift-y: -30px; --duration: 6.5s; --delay: 4s;"></div>
      <div class="particle" style="top: 25%; left: 90%; --drift-x: -50px; --drift-y: -55px; --duration: 7.5s; --delay: 2.5s;"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <img
        src="/assets/logo_icon.png"
        alt="CurtBrag Logo"
        class="w-28 h-auto mx-auto mb-8 animate-float drop-shadow-[0_0_20px_rgba(237,35,42,0.3)]"
        loading="eager"
      />
      <h1 class="text-4xl md:text-6xl font-bold font-sans mb-4 animate-fade-in">
        <span class="gradient-text">All Access.</span> No Excuses.
      </h1>
      <p class="text-text-secondary max-w-2xl mx-auto mb-10 text-lg leading-relaxed animate-fade-in delay-1">
        This ain't your average tool truck. I don't just sell tools &mdash; I build my own path and custom solutions that last, with Alina on standby.
      </p>

      <!-- Quick Contact Cluster -->
      <div class="flex flex-wrap justify-center gap-3 animate-fade-in delay-2">
        <a
          href="tel:+17814170692"
          class="btn-brand inline-flex items-center gap-2 bg-brand text-white rounded-xl px-6 py-3 font-semibold hover:bg-brand-dark transition shadow-lg shadow-brand/20 hover:shadow-brand/40 hover:scale-105"
        >
          <i class="fa-solid fa-phone"></i> Call
        </a>
        <a
          href="sms:+17814170692"
          class="btn-brand inline-flex items-center gap-2 bg-brand text-white rounded-xl px-6 py-3 font-semibold hover:bg-brand-dark transition shadow-lg shadow-brand/20 hover:shadow-brand/40 hover:scale-105"
        >
          <i class="fa-solid fa-comment-sms"></i> Text
        </a>
        <a
          href="mailto:curtbrag@yahoo.com"
          class="btn-brand inline-flex items-center gap-2 bg-brand text-white rounded-xl px-6 py-3 font-semibold hover:bg-brand-dark transition shadow-lg shadow-brand/20 hover:shadow-brand/40 hover:scale-105"
        >
          <i class="fa-solid fa-envelope"></i> Email
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ DIVIDER ═══════════════════════ -->
  <div class="section-divider mx-4"></div>

  <!-- ═══════════════════════════════════════ SERVICES ═══════════════════════════════════════ -->
  <section class="py-14 md:py-20 reveal">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold mb-1">Snap-on Services</h2>
      <div class="w-16 h-0.5 bg-gradient-to-r from-brand to-transparent mb-8"></div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger-children">
        <!-- Schedule Stop -->
        <a
          href="https://otis.curtbrag.com/curtschedule"
          target="_blank"
          rel="noopener noreferrer"
          class="card-glow p-6 block group"
        >
          <div class="text-3xl mb-4 text-green card-icon">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
          <h3 class="text-lg font-semibold mb-2 group-hover:text-brand transition">Schedule Stop</h3>
          <p class="text-text-secondary text-sm">Book a tool truck visit at your shop or location.</p>
        </a>

        <!-- Request a Tool -->
        <a
          href="https://otis.curtbrag.com/curtrequest"
          target="_blank"
          rel="noopener noreferrer"
          class="card-glow p-6 block group"
        >
          <div class="text-3xl mb-4 text-amber-500 card-icon">
            <i class="fa-solid fa-toolbox"></i>
          </div>
          <h3 class="text-lg font-semibold mb-2 group-hover:text-brand transition">Request a Tool</h3>
          <p class="text-text-secondary text-sm">Need something specific? Submit a request and I'll track it down.</p>
        </a>

        <!-- Warranty / RA Help -->
        <a
          href="https://otis.curtbrag.com/curtwarranty"
          target="_blank"
          rel="noopener noreferrer"
          class="card-glow p-6 block group"
        >
          <div class="text-3xl mb-4 text-blue card-icon">
            <i class="fa-solid fa-shield"></i>
          </div>
          <h3 class="text-lg font-semibold mb-2 group-hover:text-brand transition">Warranty / RA Help</h3>
          <p class="text-text-secondary text-sm">Broken tool? Start a warranty or return authorization.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ DIVIDER ═══════════════════════ -->
  <div class="section-divider mx-4"></div>

  <!-- ═══════════════════════════════════════ SOCIAL & LINKS ═══════════════════════════════════════ -->
  <section class="py-14 md:py-20 reveal">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold mb-1">Connect</h2>
