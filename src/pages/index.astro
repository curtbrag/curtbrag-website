  <!-- ═══════════════════════════════ BOSTON SPORTS TRACKER ═══════════════════════════════════ -->
  <section class="py-14 md:py-20 reveal">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-center gap-3 mb-1">
        <i class="fa-solid fa-trophy text-yellow text-xl"></i>
