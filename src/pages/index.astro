        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════ BOSTON SPORTS TRACKER ═══════════════════════════════════ -->
  <section class="py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-center gap-3 mb-6">
