---
import Layout from '../layouts/Layout.astro';
const services = [
  { number: '01', title: 'Bring the truck by', detail: 'Pick a time for a visit at your shop. We can look at what you need in person.', action: 'Schedule a stop', href: 'https://otis.curtbrag.com/curtschedule' },
  { number: '02', title: 'Find a specific tool', detail: 'Have a part number or a problem to solve? Send me a request and I’ll help track it down.', action: 'Request a tool', href: 'https://otis.curtbrag.com/curtrequest' },
  { number: '03', title: 'Get warranty help', detail: 'Start a warranty or return request and I’ll help you with the next step.', action: 'Start a claim', href: 'https://otis.curtbrag.com/curtwarranty' },
];
const projects = [
  { tag: 'THE BUILD', title: 'CYBERDYNE-V2', detail: 'A closer look at the dual-system rig.', href: '/rig', number: '01' },
  { tag: 'THE LAB', title: 'The Cluster', detail: 'Phones, PCs, experiments, and live systems.', href: '/cluster', number: '02' },
  { tag: 'THE COLLECTION', title: 'Cards & cars', detail: 'Trading cards, rides, and the photo archive.', href: '/gallery', number: '03' },
];
---
<Layout title="Curtis Bragdon | Snap-on Tool Truck & More" description="Tools brought to your shop. Text Curtis Bragdon, schedule a Snap-on truck stop, request a tool, or get warranty help. Explore the builds behind CurtBrag." ogImage="https://www.curtbrag.com/assets/truck_logo.png">
  <div class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> CURTIS BRAGDON <span class="eyebrow-dot">/</span> SNAP-ON TOOLS</p>
        <h1 id="hero-title">Good tools.<br /><em>Right to you.</em></h1>
        <p class="hero-lead">Your shop has work to do. I bring the tool truck to you, help you find what fits, and keep you moving.</p>
        <div class="hero-actions">
          <a class="action action-primary" href="sms:+17814170692">Text Curtis <span aria-hidden="true">↗</span></a>
          <a class="action action-outline" href="https://otis.curtbrag.com/curtschedule" target="_blank" rel="noopener noreferrer">Book a stop <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero-contact">Prefer a call? <a href="tel:+17814170692">781-417-0692</a></p>
      </div>
      <div class="hero-art">
        <div class="hero-art-top"><span>ON THE ROAD</span><span>CURTBRAG.COM ↗</span></div>
        <img src="/assets/truck_logo.png" alt="Illustration of Curtis’s Snap-on tool truck with a black dog" width="1440" height="1268" fetchpriority="high" />
        <div class="hero-art-bottom"><span>THE TRUCK COMES TO YOU.</span><span>MASSACHUSETTS</span></div>
      </div>
    </section>
    <div class="ticker" aria-label="Tool truck services"><span>TOOLS FOR THE WORK YOU DO</span><span aria-hidden="true">✳</span><span>AT YOUR SHOP, ON YOUR SCHEDULE</span><span aria-hidden="true">✳</span><span>CURTIS BRAGDON</span></div>
    <section class="services section-wrap" id="services" aria-labelledby="services-title">
      <div class="section-heading"><p class="eyebrow"><span class="eyebrow-line"></span> THE TOOL TRUCK</p><h2 id="services-title">What can I help<br /><em>you get done?</em></h2><p>Whether you know exactly what you need or want to talk it through, start here.</p></div>
      <div class="service-list">{services.map((service) => (
        <a class="service-row" href={service.href} target="_blank" rel="noopener noreferrer"><span class="service-number">{service.number}</span><span class="service-text"><strong>{service.title}</strong><small>{service.detail}</small></span><span class="service-action">{service.action} <span aria-hidden="true">↗</span></span></a>
      ))}</div>
    </section>
    <section class="route section-wrap" aria-labelledby="route-title"><div><p class="eyebrow dark"><span class="eyebrow-line"></span> YOUR LOCAL TOOL GUY</p><h2 id="route-title">Let’s get your shop<br /><em>on the route.</em></h2></div><div class="route-side"><p>Serving Lynn, Revere, Malden, Everett, and surrounding Boston-area shops. Tell me where you are and what you’re looking for.</p><a href="/contact">Get in touch <span aria-hidden="true">↗</span></a></div></section>
    <section class="projects section-wrap" id="projects" aria-labelledby="projects-title">
      <div class="projects-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span> BEYOND THE TRUCK</p><h2 id="projects-title">There’s more<br /><em>to the story.</em></h2></div><p>When I’m off the route, I’m building things, collecting things, and figuring out what’s next.</p></div>
      <div class="project-grid">{projects.map((project) => (
        <a href={project.href} class="project-card"><span class="project-icon" aria-hidden="true">{project.number}</span><span class="project-tag">{project.tag}</span><strong>{project.title}</strong><span class="project-detail">{project.detail}</span><span class="project-arrow" aria-hidden="true">↗</span></a>
      ))}</div>
      <div class="more-links"><span>KEEP EXPLORING</span><a href="/shop">Card shop ↗</a><a href="/addyourride">Add your ride ↗</a><a href="/alina">Ask Alina ↗</a><a href="/sports">Boston sports ↗</a></div>
    </section>
    <section class="closing" aria-labelledby="closing-title"><div class="section-wrap closing-inner"><div><p class="eyebrow"><span class="eyebrow-line"></span> LET’S TALK TOOLS</p><h2 id="closing-title">Need something?<br /><em>Just ask Curt.</em></h2></div><div class="closing-actions"><a href="sms:+17814170692">Send a text <span aria-hidden="true">↗</span></a><a href="tel:+17814170692">Or call 781-417-0692</a></div></div></section>
  </div>
</Layout>
<style>
.home { --paper:#ece9df; --ink:#141414; background:#141414; color:#f3f0e8; overflow:hidden; }
.section-wrap { max-width:1320px; margin:auto; padding-left:clamp(24px,5vw,80px); padding-right:clamp(24px,5vw,80px); }
.eyebrow { display:flex; align-items:center; gap:12px; color:#ed7169; font:700 11px/1.4 'JetBrains Mono',monospace; letter-spacing:.11em; }.eyebrow-line { width:24px; height:2px; flex:none; background:currentColor; }.eyebrow-dot { color:#a89f95; }
h1,h2,p { margin:0; }h1,h2 { font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-.065em; line-height:1.04; }h1 em,h2 em { color:#ed7169; font-style:normal; }
.hero { max-width:1600px; margin:auto; min-height:670px; display:grid; grid-template-columns:1fr 1.02fr; }.hero-copy { padding:clamp(70px,8vw,130px) clamp(24px,5.1vw,82px) 80px max(24px,calc((100vw - 1320px)/2 + 80px)); display:flex; flex-direction:column; align-items:flex-start; justify-content:center; }h1 { font-size:clamp(53px,6vw,96px); margin:38px 0 24px; white-space:nowrap; }.hero-lead { max-width:510px; color:#c6c3bd; font-size:clamp(16px,1.4vw,19px); line-height:1.75; }.hero-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:38px; }.action { min-height:56px; display:inline-flex; gap:30px; align-items:center; justify-content:space-between; padding:0 22px; font-size:14px; font-weight:700; transition:transform .2s,background .2s; }.action:hover,.closing-actions>a:first-child:hover { transform:translateY(-3px); }.action-primary { background:#ed5347; color:#151515; }.action-primary:hover { background:#ff756b; }.action-outline { color:#f3f0e8; border:1px solid #73706b; }.action-outline:hover { background:#30302d; }.hero-contact { font-size:13px; color:#aaa69e; margin-top:22px; }.hero-contact a { color:#f3f0e8; text-decoration:underline; text-underline-offset:4px; }
.hero-art { position:relative; background:var(--paper); color:var(--ink); min-height:580px; display:flex; flex-direction:column; overflow:hidden; }.hero-art::before { content:''; position:absolute; width:105%; height:105%; inset:0; opacity:.18; pointer-events:none; background:repeating-linear-gradient(0deg,transparent 0 41px,#b8b2a6 42px 43px); }.hero-art-top,.hero-art-bottom { position:relative; z-index:1; display:flex; justify-content:space-between; padding:25px 34px; font:700 11px/1.4 'JetBrains Mono',monospace; letter-spacing:.08em; }.hero-art-top { border-bottom:1px solid #c9c5ba; }.hero-art-bottom { border-top:1px solid #c9c5ba; margin-top:auto; }.hero-art img { position:relative; width:110%; max-width:none; height:auto; margin:auto 0 auto -6%; mix-blend-mode:multiply; }
.ticker { display:flex; align-items:center; justify-content:space-around; gap:22px; padding:17px 24px; background:#e44d42; color:#1d1614; font:700 11px/1.4 'JetBrains Mono',monospace; letter-spacing:.09em; text-align:center; }.ticker span:nth-child(even) { font-size:20px; }
.services { padding-top:120px; padding-bottom:125px; display:grid; grid-template-columns:.8fr 1.2fr; gap:8vw; }h2 { font-size:clamp(42px,4.3vw,68px); margin-top:28px; }.section-heading>p:last-child { margin-top:26px; max-width:330px; line-height:1.7; color:#b7b4ae; font-size:15px; }.service-list { border-top:1px solid #55504c; align-self:start; }.service-row { display:grid; grid-template-columns:38px minmax(0,1fr) auto; align-items:start; gap:20px; padding:28px 0; border-bottom:1px solid #55504c; transition:padding .2s,background .2s; }.service-row:hover { padding-left:10px; background:#1c1b1a; }.service-number { color:#ed7169; font:700 12px 'JetBrains Mono',monospace; padding-top:5px; }.service-text { display:flex; flex-direction:column; gap:10px; }.service-text strong { font-size:19px; letter-spacing:-.035em; }.service-text small { color:#b5b1a9; line-height:1.6; max-width:390px; font-size:13px; }.service-action { color:#f0847d; font-size:12px; font-weight:700; white-space:nowrap; padding-top:5px; }
.route { background:var(--paper); color:var(--ink); display:flex; justify-content:space-between; align-items:end; gap:60px; padding-top:80px; padding-bottom:85px; max-width:none; }.route>div:first-child { margin-left:max(0px,calc((100vw - 1320px)/2)); }.route-side { margin-right:max(0px,calc((100vw - 1320px)/2)); max-width:340px; }.eyebrow.dark { color:#a52e27; }.route h2 em { color:#bb3930; }.route-side p { line-height:1.8; font-size:15px; color:#4b4843; }.route-side a { display:inline-flex; justify-content:space-between; gap:35px; margin-top:27px; border-bottom:2px solid #141414; padding-bottom:7px; font-size:14px; font-weight:700; }
.projects { padding-top:125px; padding-bottom:120px; }.projects-heading { display:flex; justify-content:space-between; align-items:end; gap:30px; margin-bottom:42px; }.projects-heading>p { color:#aaa69f; max-width:320px; line-height:1.7; font-size:15px; }.project-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }.project-card { min-height:330px; display:flex; flex-direction:column; position:relative; padding:27px; background:#211f1e; border:1px solid #4a4541; transition:background .2s,transform .2s,border-color .2s; }.project-card:hover { background:#292624; border-color:#e35a50; transform:translateY(-4px); }.project-icon { display:grid; place-items:center; width:48px; height:48px; border:1px solid #665c57; color:#e96a60; font:700 14px 'JetBrains Mono',monospace; margin-bottom:auto; }.project-tag { color:#e96a60; font:700 10px 'JetBrains Mono',monospace; letter-spacing:.1em; margin-top:55px; }.project-card strong { font-size:24px; letter-spacing:-.05em; margin-top:10px; }.project-detail { color:#b9b5af; font-size:13px; margin-top:8px; padding-right:30px; }.project-arrow { position:absolute; right:26px; bottom:27px; font-size:23px; color:#e96a60; }.more-links { display:flex; align-items:center; flex-wrap:wrap; gap:16px 29px; padding-top:29px; }.more-links span { color:#a49d94; font:700 10px 'JetBrains Mono',monospace; letter-spacing:.09em; margin-right:10px; }.more-links a { font-size:13px; color:#d8d4cb; text-decoration:underline; text-underline-offset:5px; }.more-links a:hover { color:#ed7169; }
.closing { background:#d94a40; color:#151515; }.closing-inner { display:flex; align-items:end; justify-content:space-between; gap:40px; padding-top:76px; padding-bottom:85px; }.closing .eyebrow { color:#271817; }.closing h2 em { color:#f9eee4; }.closing-actions { display:flex; flex-direction:column; gap:18px; align-items:flex-start; }.closing-actions>a:first-child { background:#151515; color:#fff; padding:19px 22px; min-width:190px; display:flex; justify-content:space-between; gap:35px; font-size:14px; font-weight:700; transition:transform .2s; }.closing-actions>a:last-child { font-size:13px; font-weight:700; text-decoration:underline; text-underline-offset:4px; }
@media(max-width:1050px) { .hero { grid-template-columns:1fr 1fr; min-height:580px; }.hero-copy { padding:65px 30px; }h1 { white-space:normal; font-size:clamp(48px,6vw,70px); }.service-row { grid-template-columns:24px 1fr; }.service-action { grid-column:2; padding-top:0; } }
@media(max-width:760px) { .hero { display:flex; flex-direction:column; }.hero-copy { padding:72px 24px 65px; }.hero h1 { margin:26px 0 20px; }.hero-art { min-height:0; }.hero-art img { width:100%; margin:20px 0; }.hero-art-top,.hero-art-bottom { padding:17px 22px; }.ticker { justify-content:center; }.ticker span:nth-child(n+4) { display:none; }.services { display:block; padding-top:80px; padding-bottom:80px; }.section-heading { margin-bottom:38px; }.route { display:block; padding-top:70px; padding-bottom:72px; }.route>div:first-child,.route-side { margin:0; }.route-side { margin-top:35px; }.projects { padding-top:85px; padding-bottom:80px; }.projects-heading { display:block; }.projects-heading>p { margin-top:24px; }.project-grid { grid-template-columns:1fr; }.project-card { min-height:235px; }.project-tag { margin-top:30px; }.closing-inner { display:block; }.closing-actions { margin-top:40px; } }
@media(max-width:480px) { .hero h1 { font-size:clamp(43px,12vw,57px); }.hero-actions { width:100%; }.action { width:100%; }.ticker { gap:10px; font-size:9px; padding:15px 10px; }.ticker span:nth-child(3) { display:none; }.hero-art-top,.hero-art-bottom { font-size:9px; }.service-row { gap:12px; }.service-text strong { font-size:17px; }.more-links span { width:100%; } }
</style>
