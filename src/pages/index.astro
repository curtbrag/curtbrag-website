        <div class="divide-y divide-border">
          <div class="flex justify-between items-center py-3">
            <span class="font-semibold">Red Sox</span>
            <span id="score-redsox" class="text-text-secondary text-sm">Loading...</span>
          </div>
          <div class="flex justify-between items-center py-3">
            <span class="font-semibold">Patriots</span>
            <span id="score-patriots" class="text-text-secondary text-sm">Loading...</span>
          </div>
          <div class="flex justify-between items-center py-3">
            <span class="font-semibold">Celtics</span>
            <span id="score-celtics" class="text-text-secondary text-sm">Loading...</span>
          </div>
          <div class="flex justify-between items-center py-3">
            <span class="font-semibold">Bruins</span>
            <span id="score-bruins" class="text-text-secondary text-sm">Loading...</span>
          </div>
          <div class="flex justify-between items-center py-3">
            <span class="font-semibold">Revolution</span>
            <span id="score-revolution" class="text-text-secondary text-sm">Loading...</span>
