          class="inline-flex items-center gap-2 bg-surface border border-border rounded-lg px-5 py-3 text-sm hover:border-brand hover:bg-panel-hover hover:scale-105 transition-all duration-300 group">
          <i class="fa-brands fa-square-cash-app text-green group-hover:scale-110 transition-transform"></i> CashApp
        </a>
        <a href="https://otis.curtbrag.com/curtvenmo" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-surface border border-border rounded-lg px-5 py-3 text-sm hover:border-brand hover:bg-panel-hover hover:scale-105 transition-all duration-300 group">
          <i class="fa-brands fa-paypal text-blue group-hover:scale-110 transition-transform"></i> Venmo
        </a>
        <a href="https://otis.curtbrag.com/curtspotify" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-surface border border-border rounded-lg px-5 py-3 text-sm hover:border-brand hover:bg-panel-hover hover:scale-105 transition-all duration-300 group">
          <i class="fa-brands fa-spotify text-green group-hover:scale-110 transition-transform"></i> Spotify
