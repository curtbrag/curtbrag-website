    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold mb-1">Quick Pay</h2>
      <div class="w-16 h-0.5 bg-gradient-to-r from-brand to-transparent mb-8"></div>

      <div class="flex flex-wrap gap-3 justify-center stagger-children">
        <a href="https://otis.curtbrag.com/curtdk" target="_blank" rel="noopener noreferrer"
