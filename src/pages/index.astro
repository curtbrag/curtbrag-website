  <!-- ═══════════════════════════════════════ PAYMENTS ═══════════════════════════════════════ -->
  <section class="py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold mb-6">Quick Pay</h2>

      <div class="flex flex-wrap gap-3 justify-center">
        <a href="https://otis.curtbrag.com/curtdk" target="_blank" rel="noopener noreferrer"
