            <i class="fa-solid fa-images"></i>
          </div>
          <h3 class="font-semibold mb-1 group-hover:text-brand transition">Photo Gallery</h3>
          <p class="text-text-secondary text-sm">Cars, Snap-on, and PC build photos</p>
        </a>

        <!-- Card Shop -->
        <a href="/shop" class="card-glow p-5 block group">
