---
import Layout from '../../layouts/Layout.astro';
const collections = [
  { title:'On the road', href:'/gallery/cars/', image:'/gallery/cars/20140328_111738.jpg', alt:'Customer cars and trucks from Curtis’s route', tag:'CARS & TRUCKS', text:'Customer rides and shop visits from around the Boston area.' },
  { title:'Life on the truck', href:'/gallery/snapon/', image:'/gallery/snapon/20160811_173654.jpg', alt:'Snap-on truck and tools', tag:'SNAP-ON', text:'The tools, the truck and the people behind the route.' },
  { title:'Inside the build', href:'/rig/#rig-hero-img', image:'/assets/pc/01_full_dual_system_rgb.webp', alt:'CYBERDYNE dual-system PC with RGB illumination', tag:'CYBERDYNE', text:'The custom rig, its components and the details that bring it together.' },
];
---
<Layout title="Gallery · CurtBrag" description="Explore customer rides, Snap-on tools and the CYBERDYNE custom build.">
  <section class="max-w-6xl mx-auto px-5 py-12">
    <header class="site-collection-header"><p class="site-eyebrow">THE COLLECTIONS</p><h1>More than a photo roll.</h1><p>Real projects. Customer rides. A few things built along the way.<br/>Choose a collection and take a closer look.</p></header>
    <div class="site-collection-grid">{collections.map(collection => <a class="site-collection-card" href={collection.href}><div style="overflow:hidden"><img src={collection.image} alt={collection.alt} width="600" height="420" loading="lazy"/></div><div><span>{collection.tag}</span><h2>{collection.title}</h2><p>{collection.text}</p><span>Explore collection ↗</span></div></a>)}</div>
    <aside class="site-collection-callout"><div><h2>Your ride belongs here.</h2><p>Send a car or truck photo for the customer gallery.</p></div><a class="site-secondary-link" href="/addyourride/">Add your ride <span aria-hidden="true">↗</span></a></aside>
  </section>
</Layout>
