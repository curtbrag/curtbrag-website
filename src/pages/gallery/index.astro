---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Photo Gallery - Curtis Bragdon" description="Browse Curtis Bragdon's photo galleries - cars, Snap-on tools, and more.">

  <!-- ═══════════════════════════════════════════ HEADER ═══════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-3">
        <i class="fa-solid fa-images text-brand mr-3"></i>Photo Gallery
      </h1>
      <p class="text-text-secondary text-lg">Browse the collections</p>
    </div>

    <!-- ═══════════════════════════════════════ GALLERY CARDS ═══════════════════════════════════════ -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">

      <!-- Cars Gallery -->
      <a href="/gallery/cars" class="bg-panel border border-border rounded-2xl overflow-hidden hover:border-border-hover hover:-translate-y-1 transition-all duration-300 group block">
        <img
          src="/gallery/cars/20140328_111738.jpg"
          alt="Cars Gallery"
          class="w-full h-52 object-cover"
          loading="lazy"
        />
        <div class="p-6">
          <h2 class="text-xl font-bold mb-2 group-hover:text-brand transition">
            <i class="fa-solid fa-car mr-2"></i>Cars Gallery
          </h2>
          <p class="text-text-secondary text-sm">Customer cars, trucks, and rides from around Boston</p>
          <span class="inline-block bg-surface text-muted text-xs px-3 py-1 rounded-full mt-3">100+ photos</span>
        </div>
      </a>

      <!-- Snap-on Gallery -->
      <a href="/gallery/snapon" class="bg-panel border border-border rounded-2xl overflow-hidden hover:border-border-hover hover:-translate-y-1 transition-all duration-300 group block">
        <img
          src="/gallery/snapon/20160811_173654.jpg"
          alt="Snap-on Gallery"
          class="w-full h-52 object-cover"
          loading="lazy"
        />
        <div class="p-6">
          <h2 class="text-xl font-bold mb-2 group-hover:text-brand transition">
            <i class="fa-solid fa-wrench mr-2"></i>Snap-on Gallery
          </h2>
          <p class="text-text-secondary text-sm">Tools, truck photos, and Snap-on memories</p>
          <span class="inline-block bg-surface text-muted text-xs px-3 py-1 rounded-full mt-3">250+ photos</span>
        </div>
      </a>

    </div>

    <!-- ═══════════════════════════════════════ CTA ═══════════════════════════════════════ -->
    <div class="max-w-4xl mx-auto mt-12">
      <div class="bg-panel border border-border rounded-2xl p-8 text-center">
        <h3 class="text-xl font-bold mb-2">Got a Ride to Share?</h3>
        <p class="text-text-secondary mb-6">Submit your car or truck to be featured!</p>
        <a
          href="/addyourride"
          class="inline-flex items-center gap-2 bg-brand text-white rounded-xl px-6 py-3 font-semibold hover:bg-brand-dark transition shadow-lg shadow-brand/20"
        >
          <i class="fa-solid fa-car-side"></i> Add Your Ride
        </a>
      </div>
    </div>

  </section>

</Layout>
