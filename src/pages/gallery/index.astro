---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Photo Gallery - Curtis Bragdon" description="Browse Curtis Bragdon's photo galleries - cars, Snap-on tools, and CYBERDYNE PC build photos." ogImage="https://www.curtbrag.com/gallery/cars/20140328_111738.jpg">
<Layout title="Photo Gallery - Curtis Bragdon" description="Browse Curtis Bragdon's photo galleries - cars, Snap-on tools, and CYBERDYNE PC build photos.">

  <!-- ═══════════════════════════════════════════ HEADER ═══════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-12 reveal">
      <h1 class="text-4xl md:text-5xl font-bold mb-3">
        <i class="fa-solid fa-images text-brand mr-3"></i><span class="gradient-text">Photo Gallery</span>
      </h1>
      <p class="text-text-secondary text-lg">Browse the collections</p>
    </div>

    <!-- ═══════════════════════════════════════ GALLERY CARDS ═══════════════════════════════════════ -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto stagger-children">

      <!-- Cars Gallery -->
      <a href="/gallery/cars" class="card-glow overflow-hidden group block reveal">
        <div class="relative overflow-hidden">
          <img
            src="/gallery/cars/20140328_111738.jpg"
            alt="Cars Gallery"
            class="w-full h-52 object-cover transition-transform duration-500 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
        <div class="p-6">
          <h2 class="text-xl font-bold mb-2 group-hover:text-brand transition">
            <i class="fa-solid fa-car mr-2"></i>Cars Gallery
          </h2>
          <p class="text-text-secondary text-sm">Customer cars, trucks, and rides from around Boston</p>
          <span class="inline-block bg-surface text-muted text-xs px-3 py-1 rounded-full mt-3 badge-glow">100+ photos</span>
        </div>
      </a>

      <!-- Snap-on Gallery -->
      <a href="/gallery/snapon" class="card-glow overflow-hidden group block reveal">
        <div class="relative overflow-hidden">
          <img
            src="/gallery/snapon/20160811_173654.jpg"
            alt="Snap-on Gallery"
            class="w-full h-52 object-cover transition-transform duration-500 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
        <div class="p-6">
          <h2 class="text-xl font-bold mb-2 group-hover:text-brand transition">
            <i class="fa-solid fa-wrench mr-2"></i>Snap-on Gallery
          </h2>
          <p class="text-text-secondary text-sm">Tools, truck photos, and Snap-on memories</p>
          <span class="inline-block bg-surface text-muted text-xs px-3 py-1 rounded-full mt-3 badge-glow">250+ photos</span>
        </div>
      </a>

      <!-- PC Build Gallery -->
      <a href="/rig#rig-hero-img" class="card-glow overflow-hidden group block reveal">
        <div class="relative overflow-hidden">
          <img
            src="/assets/pc/01_full_dual_system_rgb.webp"
            alt="CYBERDYNE PC Build Gallery"
            class="w-full h-52 object-cover transition-transform duration-500 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
        <div class="p-6">
          <h2 class="text-xl font-bold mb-2 group-hover:text-blue transition">
            <i class="fa-solid fa-microchip mr-2"></i>PC Build
          </h2>
          <p class="text-text-secondary text-sm">CYBERDYNE dual-system build photos and detail shots</p>
          <span class="inline-block bg-surface text-muted text-xs px-3 py-1 rounded-full mt-3 badge-glow">35 photos</span>
        </div>
      </a>

    </div>

    <!-- ═══════════════════════════════════════ CTA ═══════════════════════════════════════ -->
    <div class="max-w-5xl mx-auto mt-12 reveal">
      <div class="card-glow p-8 text-center">
        <h3 class="text-xl font-bold mb-2">Got a Ride to Share?</h3>
        <p class="text-text-secondary mb-6">Submit your car or truck to be featured!</p>
        <a
          href="/addyourride"
          class="btn-brand inline-flex items-center gap-2 bg-brand text-white rounded-xl px-6 py-3 font-semibold hover:bg-brand-dark transition shadow-lg shadow-brand/20 hover:shadow-brand/40 hover:scale-105"
        >
          <i class="fa-solid fa-car-side"></i> Add Your Ride
        </a>
      </div>
    </div>

  </section>

</Layout>
