---
import Layout from '../../layouts/Layout.astro';
import images from '../../data/gallery-cars.json';
const basePath = '/gallery/cars/';
---

<Layout title="Cars Gallery - Curtis Bragdon" description="Customer cars, trucks, and rides from Curtis Bragdon's Snap-on route around Boston.">

  <!-- ═══════════════════════════════════════════ HEADER ═══════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-brand transition">Home</a></li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs"></i></li>
        <li><a href="/gallery" class="hover:text-brand transition">Gallery</a></li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs"></i></li>
        <li class="text-text" aria-current="page">Cars</li>
      </ol>
    </nav>

    <div class="text-center mb-10">
      <h1 class="text-4xl md:text-5xl font-bold mb-3">
        <i class="fa-solid fa-car text-brand mr-3" aria-hidden="true"></i>Cars Gallery
      </h1>
      <p class="text-text-secondary text-lg">Customer rides from around Boston</p>
    </div>

    <!-- ═══════════════════════════════════════ GALLERY GRID ═══════════════════════════════════════ -->
    <div id="gallery-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      {images.map((image, index) => <a href={basePath + image} data-index={index} data-image={image} class="gallery-tile rounded-xl overflow-hidden bg-panel hover:scale-[1.02] transition" aria-label={`Open car photo ${index + 1}`}><img src={basePath + image} alt={`Car photo ${index + 1}`} class="w-full h-48 object-cover" width="600" height="420" loading="lazy" /></a>)}
    </div>

    <!-- ═══════════════════════════════════════ CTA ═══════════════════════════════════════ -->
    <div class="mt-12 text-center">
      <div class="bg-panel border border-border rounded-2xl p-8 max-w-2xl mx-auto">
        <h3 class="text-xl font-bold mb-2">Got a Ride to Share?</h3>
        <p class="text-text-secondary mb-6">Submit your car or truck to be featured in the gallery!</p>
        <a
          href="/addyourride"
          class="inline-flex items-center gap-2 bg-brand text-white rounded-xl px-6 py-3 font-semibold hover:bg-brand-dark transition shadow-lg shadow-brand/20"
        >
          <i class="fa-solid fa-car-side"></i> Add Your Ride
        </a>
      </div>
    </div>

    <!-- Share Button -->
    <div class="mt-8 text-center">
      <button
        id="share-btn"
        class="inline-flex items-center gap-2 bg-panel border border-border rounded-xl px-6 py-3 text-text hover:border-brand transition font-medium"
      >
        <i class="fa-solid fa-share-nodes"></i> Share Gallery
      </button>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ LIGHTBOX ═══════════════════════════════════════ -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Photo viewer" class="fixed inset-0 bg-black/95 z-[80] hidden items-center justify-center">
    <!-- Close -->
    <button id="lb-close" class="absolute top-4 right-4 text-white text-3xl hover:text-brand transition z-10" aria-label="Close lightbox">
      <i class="fa-solid fa-xmark"></i>
    </button>

    <!-- Prev -->
    <button id="lb-prev" class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-brand text-white flex items-center justify-center hover:bg-brand-dark transition z-10" aria-label="Previous photo">
      <i class="fa-solid fa-chevron-left"></i>
    </button>

    <!-- Image -->
    <img id="lb-img" src="" alt="Gallery photo" class="max-h-[85vh] max-w-[90vw] object-contain select-none" />

    <!-- Next -->
    <button id="lb-next" class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-brand text-white flex items-center justify-center hover:bg-brand-dark transition z-10" aria-label="Next photo">
      <i class="fa-solid fa-chevron-right"></i>
    </button>

    <!-- Counter -->
    <div id="lb-counter" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/70 text-sm font-medium"></div>
  </div>

  <!-- ═══════════════════════════════════════ BACK TO TOP ═══════════════════════════════════════ -->
  <button
    id="back-to-top"
    class="fixed bottom-6 right-6 w-12 h-12 rounded-full bg-brand text-white flex items-center justify-center shadow-lg hover:bg-brand-dark transition opacity-0 pointer-events-none z-40"
    aria-label="Back to top"
  >
    <i class="fa-solid fa-chevron-up"></i>
  </button>

</Layout>

<script is:inline>
  (function() {
    const images = Array.from(document.querySelectorAll('#gallery-grid [data-image]')).map(function(item) { return item.dataset.image; });

    const basePath = "/gallery/cars/";
    let currentIndex = 0;

    // Links work without JavaScript; enhance ordinary clicks into the photo viewer.
    const grid = document.getElementById("gallery-grid");
    if (grid) grid.querySelectorAll('[data-index]').forEach(function(link) {
      link.addEventListener('click', function(event) {
        if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault(); openLightbox(Number(link.dataset.index));
      });
    });

    // ── Lightbox ──
    var lightbox = document.getElementById("lightbox");
    var lbImg = document.getElementById("lb-img");
    var lbCounter = document.getElementById("lb-counter");
    var lbClose = document.getElementById("lb-close");
    var lbPrev = document.getElementById("lb-prev");
    var lbNext = document.getElementById("lb-next");

    var background = [];
    var previousOverflow = '';
    function openLightbox(idx) {
      previousOverflow = document.body.style.overflow;
      background = [];
      for (var branch = lightbox; branch && branch !== document.body; branch = branch.parentElement) {
        Array.from(branch.parentElement.children).forEach(function(element) {
          if (element !== branch && element instanceof HTMLElement) { background.push([element, element.inert]); element.inert = true; }
        });
      }
      currentIndex = idx;
      updateLightboxImage();
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
      lightbox.setAttribute("aria-hidden", "false");
      lbClose.focus();
    }

    function closeLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = previousOverflow;
      background.forEach(function(entry) { entry[0].inert = entry[1]; });
      background = [];
      lightbox.setAttribute("aria-hidden", "true");
      grid.querySelector(`[data-index="${currentIndex}"]`)?.focus();
    }

    lightbox.addEventListener('keydown', function(event) {
      if (event.key !== 'Tab') return;
      const targets = [lbClose, lbPrev, lbNext];
      const first = targets[0], last = targets[targets.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });

    function updateLightboxImage() {
      lbImg.src = basePath + images[currentIndex];
      lbImg.alt = "Car photo " + (currentIndex + 1) + " of " + images.length;
      lbCounter.textContent = (currentIndex + 1) + " / " + images.length;
    }

    function prevImage() {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      updateLightboxImage();
    }

    function nextImage() {
      currentIndex = (currentIndex + 1) % images.length;
      updateLightboxImage();
    }

    if (lbClose) lbClose.addEventListener("click", closeLightbox);
    if (lbPrev) lbPrev.addEventListener("click", prevImage);
    if (lbNext) lbNext.addEventListener("click", nextImage);

    // Click outside image to close
    if (lightbox) {
      lightbox.addEventListener("click", function(e) {
        if (e.target === lightbox) {
          closeLightbox();
        }
      });
    }

    // Keyboard navigation
    document.addEventListener("keydown", function(e) {
      if (lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") prevImage();
      if (e.key === "ArrowRight") nextImage();
    });

    // Touch / Swipe support
    var touchStartX = 0;
    var touchEndX = 0;

    if (lightbox) {
      lightbox.addEventListener("touchstart", function(e) {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      lightbox.addEventListener("touchend", function(e) {
        touchEndX = e.changedTouches[0].screenX;
        var diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) {
            nextImage();
          } else {
            prevImage();
          }
        }
      }, { passive: true });
    }

    // ── Back to Top ──
    var backToTop = document.getElementById("back-to-top");
    if (backToTop) {
      window.addEventListener("scroll", function() {
        if (window.scrollY > 400) {
          backToTop.classList.remove("opacity-0", "pointer-events-none");
          backToTop.classList.add("opacity-100");
        } else {
          backToTop.classList.add("opacity-0", "pointer-events-none");
          backToTop.classList.remove("opacity-100");
        }
      });

      backToTop.addEventListener("click", function() {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    // ── Share ──
    var shareBtn = document.getElementById("share-btn");
    if (shareBtn) {
      shareBtn.addEventListener("click", function() {
        var shareData = {
          title: "Cars Gallery - Curtis Bragdon",
          text: "Check out customer cars and rides from Curtis Bragdon's Snap-on route!",
          url: window.location.href
        };

        if (navigator.share) {
          navigator.share(shareData).catch(function() {});
        } else {
          navigator.clipboard.writeText(window.location.href).then(function() {
            shareBtn.innerHTML = '<i class="fa-solid fa-check"></i> Link Copied!';
            setTimeout(function() {
              shareBtn.innerHTML = '<i class="fa-solid fa-share-nodes"></i> Share Gallery';
            }, 2000);
          }).catch(function() {});
        }
      });
    }
  })();
</script>

