---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Snap-on Gallery - Curtis Bragdon" description="Tools, truck photos, and Snap-on memories from Curtis Bragdon.">

  <!-- ═══════════════════════════════════════════ HEADER ═══════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-brand transition">Home</a></li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs"></i></li>
        <li><a href="/gallery" class="hover:text-brand transition">Gallery</a></li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs"></i></li>
        <li class="text-text" aria-current="page">Snap-on</li>
      </ol>
    </nav>

    <div class="text-center mb-10">
      <h1 class="text-4xl md:text-5xl font-bold mb-3">
        <i class="fa-solid fa-wrench text-brand mr-3" aria-hidden="true"></i>Snap-on Gallery
      </h1>
      <p class="text-text-secondary text-lg">Tools, truck, and memories</p>
    </div>

    <!-- ═══════════════════════════════════════ GALLERY GRID ═══════════════════════════════════════ -->
    <div id="gallery-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      <!-- Images injected by JavaScript -->
    </div>

    <!-- Share Button -->
    <div class="mt-8 text-center">
      <button
        id="share-btn"
        class="inline-flex items-center gap-2 bg-panel border border-border rounded-xl px-6 py-3 text-text hover:border-brand transition font-medium"
      >
        <i class="fa-solid fa-share-nodes"></i> Share Gallery
      </button>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ LIGHTBOX ═══════════════════════════════════════ -->
  <div id="lightbox" class="fixed inset-0 bg-black/95 z-50 hidden items-center justify-center">
    <!-- Close -->
    <button id="lb-close" class="absolute top-4 right-4 text-white text-3xl hover:text-brand transition z-10" aria-label="Close lightbox">
      <i class="fa-solid fa-xmark"></i>
    </button>

    <!-- Prev -->
    <button id="lb-prev" class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-brand text-white flex items-center justify-center hover:bg-brand-dark transition z-10" aria-label="Previous photo">
      <i class="fa-solid fa-chevron-left"></i>
    </button>

    <!-- Image -->
    <img id="lb-img" src="" alt="Gallery photo" class="max-h-[85vh] max-w-[90vw] object-contain select-none" />

    <!-- Next -->
    <button id="lb-next" class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-brand text-white flex items-center justify-center hover:bg-brand-dark transition z-10" aria-label="Next photo">
      <i class="fa-solid fa-chevron-right"></i>
    </button>

    <!-- Counter -->
    <div id="lb-counter" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/70 text-sm font-medium"></div>
  </div>

  <!-- ═══════════════════════════════════════ BACK TO TOP ═══════════════════════════════════════ -->
  <button
    id="back-to-top"
    class="fixed bottom-6 right-6 w-12 h-12 rounded-full bg-brand text-white flex items-center justify-center shadow-lg hover:bg-brand-dark transition opacity-0 pointer-events-none z-40"
    aria-label="Back to top"
  >
    <i class="fa-solid fa-chevron-up"></i>
  </button>

</Layout>

