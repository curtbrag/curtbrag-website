<Layout title="Page not found · CurtBrag" description="Find your next stop on CurtBrag.">
  <section class="max-w-3xl mx-auto px-5 py-20"><p class="site-eyebrow">404 / WRONG TURN</p><h1 class="text-4xl md:text-5xl font-bold mt-4 mb-5">This page is missing.</h1><p class="text-text-secondary mb-8">The link may have changed. Head home, open the dashboard or search the site to find what you need.</p><div class="flex gap-3 flex-wrap"><a class="site-primary-link" href="/">Back to home ↗</a><a class="site-secondary-link" href="/cluster/dashboard/">Open dashboard ↗</a><button class="site-secondary-link" type="button" data-open-site-search>Find a page</button></div></section>
</Layout>
