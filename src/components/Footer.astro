---
const pages = [{href:'/gallery/',label:'Gallery'},{href:'/shop/',label:'Card shop'},{href:'/rig/',label:'The rig'},{href:'/cluster/',label:'Cluster'},{href:'/cluster/dashboard/',label:'Work dashboard'},{href:'/cluster/control/',label:'Phone controller'}];
const services = [{href:'/contact/?subject=Schedule%20a%20stop',label:'Schedule a stop'},{href:'/contact/?subject=Tool%20request',label:'Request a tool'},{href:'/contact/?subject=Warranty%20help',label:'Warranty help'},{href:'/addyourride/',label:'Add your ride'}];
---
<footer class="site-footer">
  <div class="site-footer-grid">
    <div class="site-footer-brand"><a class="site-brand" href="/"><img src="/assets/logo_icon.png" alt="CurtBrag home" width="66" height="50" loading="lazy" /><span>CURTBRAG<small>ALL ACCESS. NO EXCUSES.</small></span></a><p>Tools for the job. Builds for the next idea.<br/>Curtis Bragdon · Boston, Massachusetts.</p><a class="site-footer-contact" href="sms:+17814170692">Text Curtis <span aria-hidden="true">↗</span></a></div>
    <nav aria-label="Footer explore"><h2>Explore</h2>{pages.map(page => <a href={page.href}>{page.label}</a>)}</nav>
    <nav aria-label="Footer services"><h2>On the route</h2>{services.map(service => <a href={service.href} target={service.href.startsWith('https:') ? '_blank' : undefined} rel={service.href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{service.label}</a>)}</nav>
    <div class="site-footer-connect"><h2>Stay connected</h2><a href="tel:+17814170692">781-417-0692</a><a href="mailto:curtbrag@yahoo.com">curtbrag@yahoo.com</a><div class="site-social-links"><a href="https://www.instagram.com/curtbrag" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a><a href="https://www.facebook.com/curtbrag" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="fa-brands fa-facebook" aria-hidden="true"></i></a><a href="https://www.tiktok.com/@curtbrag" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><i class="fa-brands fa-tiktok" aria-hidden="true"></i></a><a href="https://www.youtube.com/@curtbrag" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><i class="fa-brands fa-youtube" aria-hidden="true"></i></a></div></div>
  </div>
  <div class="site-footer-bottom"><span>© {new Date().getFullYear()} Curtis Bragdon</span><span class="site-private-label"><i class="fa-solid fa-lock" aria-hidden="true"></i> Private access</span><div><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/contact/">Contact</a></div></div>
</footer>
