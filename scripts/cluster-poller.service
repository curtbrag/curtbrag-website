[Unit]
Description=Cluster Command Poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
ExecStart=/bin/sh /home/user/poll-cluster-commands.sh
Restart=always
RestartSec=10
# Set CLUSTER_API_KEY in /home/user/.cluster-env (created by setup-node1.sh / fix-cluster.sh)
EnvironmentFile=-/home/user/.cluster-env

[Install]
WantedBy=multi-user.target
