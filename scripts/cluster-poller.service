[Unit]
Description=Cluster Command Poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
ExecStart=/bin/sh /home/user/poll-cluster-commands.sh
Restart=always
RestartSec=10
# Set CLUSTER_API_KEY in /etc/environment or via EnvironmentFile=
EnvironmentFile=-/etc/cluster-env

[Install]
WantedBy=multi-user.target
