[Unit]
Description=Cluster Command Poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
ExecStart=/bin/sh /home/user/poll-cluster-commands.sh
Restart=always
RestartSec=10
# CLUSTER_API_KEY must be set before starting the service
# Create /etc/default/cluster-poller with: CLUSTER_API_KEY=<your-key>
EnvironmentFile=-/etc/default/cluster-poller

[Install]
WantedBy=multi-user.target
